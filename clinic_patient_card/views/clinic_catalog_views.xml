<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ Procedures = standard service products ============ -->
    <record id="view_clinic_procedure_list" model="ir.ui.view">
        <field name="name">clinic.procedure.product.list</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="default_code" optional="show"/>
                <field name="name"/>
                <field name="list_price"/>
                <field name="type"/>
                <field name="is_clinic_procedure" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_clinic_procedures" model="ir.actions.act_window">
        <field name="name">Procedures</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_clinic_procedure', '=', True)]</field>
        <field name="context">{'default_is_clinic_procedure': True, 'default_type': 'service'}</field>
        <field name="view_id" ref="view_clinic_procedure_list"/>
    </record>

    <!-- ============ Insurance companies = standard contacts ============ -->
    <record id="action_clinic_insurance_companies" model="ir.actions.act_window">
        <field name="name">Insurance Companies</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_insurance_company', '=', True)]</field>
        <field name="context">{'default_is_insurance_company': True, 'default_is_company': True}</field>
    </record>

    <!-- ============ Clinic working schedule (one per company) ============ -->
    <record id="view_company_form_clinic" model="ir.ui.view">
        <field name="name">res.company.form.clinic</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="clinic_schedule" string="Clinic Schedule">
                    <group>
                        <group string="Working Days">
                            <field name="clinic_workday_mon"/>
                            <field name="clinic_workday_tue"/>
                            <field name="clinic_workday_wed"/>
                            <field name="clinic_workday_thu"/>
                            <field name="clinic_workday_fri"/>
                            <field name="clinic_workday_sat"/>
                            <field name="clinic_workday_sun"/>
                        </group>
                        <group string="Working Hours">
                            <field name="clinic_work_start" widget="float_time"/>
                            <field name="clinic_work_end" widget="float_time"/>
                            <field name="clinic_block_room_overlap"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- ===================== Menus ===================== -->
    <!-- Root visible to any clinic role (incl. suppliers, who only get the
         supplier child menus below). -->
    <menuitem id="menu_clinic_root" name="Clinic" sequence="90"
              groups="clinic_patient_card.group_clinic_admin,clinic_patient_card.group_clinic_doctor,clinic_patient_card.group_clinic_supplier"/>
    <!-- Clinic-staff-only config; suppliers must not see it. -->
    <menuitem id="menu_clinic_config" name="Configuration"
              parent="menu_clinic_root" sequence="10"
              groups="clinic_patient_card.group_clinic_admin,clinic_patient_card.group_clinic_doctor"/>
    <menuitem id="menu_clinic_procedures" name="Procedures"
              parent="menu_clinic_config" action="action_clinic_procedures" sequence="10"
              groups="clinic_patient_card.group_clinic_admin,clinic_patient_card.group_clinic_doctor"/>
    <menuitem id="menu_clinic_insurance" name="Insurance Companies"
              parent="menu_clinic_config" action="action_clinic_insurance_companies" sequence="20"
              groups="clinic_patient_card.group_clinic_admin,clinic_patient_card.group_clinic_doctor"/>

</odoo>
