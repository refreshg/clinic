<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===== Appointment form = INHERIT the base calendar.event form, so the
         clinic buttons/fields appear on every calendar.event form (Planning,
         standard Calendar, Clinic > Appointments, activities). ===== -->
    <record id="view_clinic_appointment_form" model="ir.ui.view">
        <field name="name">clinic.appointment.form.inherit</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form"/>
        <field name="arch" type="xml">
            <!-- The meeting-style "Send email" header button confuses staff on
                 a clinic booking (reviewer: "instead of Send message there
                 should be the booking action") — hidden for clinic visits;
                 the clinic workflow buttons take its place. -->
            <xpath expr="//header/button[@name='action_open_composer']" position="attributes">
                <attribute name="invisible">is_clinic or not user_can_edit</attribute>
            </xpath>

            <xpath expr="//header" position="inside">
                <button name="action_confirm" type="object" string="Confirm"
                        groups="clinic_patient_card.group_clinic_admin" class="btn-primary"
                        invisible="not is_clinic or clinic_state not in ('requested','booked')"/>
                <button name="action_arrive" type="object" string="Arrived"
                        groups="clinic_patient_card.group_clinic_admin" class="btn-primary"
                        invisible="not is_clinic or clinic_state not in ('booked','confirmed')"/>
                <button name="action_start" type="object" string="Start"
                        groups="clinic_patient_card.group_clinic_doctor" class="btn-primary"
                        invisible="not is_clinic or clinic_state != 'arrived'"/>
                <button name="action_done" type="object" string="Done"
                        groups="clinic_patient_card.group_clinic_doctor" class="btn-primary"
                        invisible="not is_clinic or clinic_state != 'in_progress'"/>
                <button name="action_pay" type="object" string="Register Payment"
                        groups="clinic_patient_card.group_clinic_admin" class="btn-primary"
                        invisible="not is_clinic or clinic_state != 'done'"/>
                <button name="action_cancel" type="object" string="Cancel"
                        groups="clinic_patient_card.group_clinic_admin"
                        invisible="not is_clinic or clinic_state in ('paid','cancelled','no_show')"/>
                <button name="action_no_show" type="object" string="No-Show"
                        groups="clinic_patient_card.group_clinic_admin"
                        invisible="not is_clinic or clinic_state not in ('booked','confirmed','arrived')"/>
                <button name="action_next_visit" type="object" string="Next Visit"
                        groups="clinic_patient_card.group_clinic_admin,clinic_patient_card.group_clinic_doctor"
                        invisible="not is_clinic or clinic_state not in ('done','paid')"/>
                <button name="action_dispensary_next" type="object" string="Dispensary +6m"
                        groups="clinic_patient_card.group_clinic_admin,clinic_patient_card.group_clinic_doctor"
                        invisible="not is_clinic or clinic_state not in ('done','paid')"/>
                <button name="action_book" type="object" string="Confirm to Calendar"
                        class="btn-primary"
                        groups="clinic_patient_card.group_clinic_admin"
                        invisible="not is_clinic or clinic_state != 'requested'"/>
                <button name="action_to_reserve" type="object" string="To Reserve"
                        groups="clinic_patient_card.group_clinic_admin"
                        invisible="not is_clinic or clinic_state not in ('booked','confirmed')"/>
                <field name="clinic_state" widget="statusbar" invisible="not is_clinic"
                       statusbar_visible="booked,confirmed,arrived,in_progress,done,paid"/>
            </xpath>

            <!-- Hide meeting-only fields for clinic visits: Location, Video Link,
                 and the whole guests/attendees block (counter + attendees +
                 EMAIL/SMS). They stay for ordinary calendar events. -->
            <xpath expr="//field[@name='location']" position="attributes">
                <attribute name="invisible">is_clinic</attribute>
            </xpath>
            <xpath expr="//label[@for='videocall_location']" position="attributes">
                <attribute name="invisible">is_clinic</attribute>
            </xpath>
            <xpath expr="//field[@name='videocall_location']" position="attributes">
                <attribute name="invisible">is_clinic</attribute>
            </xpath>
            <xpath expr="//div[hasclass('mb-2')][@colspan='2']" position="attributes">
                <attribute name="invisible">is_clinic</attribute>
            </xpath>

            <!-- More meeting-only machinery hidden for clinic visits
                 (reviewer's screenshot): the "Going?" RSVP badge and the
                 Busy/visibility status row. -->
            <xpath expr="//field[@name='current_status']" position="attributes">
                <attribute name="invisible">is_clinic or not should_show_status</attribute>
            </xpath>
            <xpath expr="//label[@for='privacy']" position="attributes">
                <attribute name="invisible">is_clinic</attribute>
            </xpath>
            <xpath expr="//field[@name='show_as']" position="attributes">
                <attribute name="invisible">is_clinic</attribute>
            </xpath>
            <xpath expr="//field[@name='privacy']" position="attributes">
                <attribute name="invisible">is_clinic</attribute>
            </xpath>

            <!-- Open the Clinic tab first for clinic visits. -->
            <xpath expr="//notebook/page[1]" position="attributes">
                <attribute name="autofocus"/>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page name="clinic_page" string="Clinic" invisible="not is_clinic"
                      autofocus="autofocus">
                    <group>
                        <group>
                            <field name="is_clinic"/>
                            <field name="patient_id" required="is_clinic"
                                   context="{'clinic_show_ids': 1}"/>
                            <field name="appointment_type_id"/>
                            <field name="diagnosis"/>
                            <field name="cancel_reason"
                                   invisible="clinic_state != 'cancelled'"
                                   required="clinic_state == 'cancelled'"/>
                        </group>
                        <group>
                            <field name="dentist_id"/>
                            <field name="assistant_id"/>
                            <field name="room_id"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount_paid" widget="monetary"
                                   invisible="clinic_state != 'paid'"/>
                            <field name="amount_cash" widget="monetary"
                                   invisible="payment_method != 'mixed' or clinic_state != 'paid'"/>
                            <field name="amount_terminal" widget="monetary"
                                   invisible="payment_method != 'mixed' or clinic_state != 'paid'"/>
                            <field name="payment_method" invisible="1"/>
                        </group>
                    </group>
                    <group string="Procedures"
                           invisible="clinic_state in ('requested','booked','confirmed')">
                        <field name="procedure_line_ids" nolabel="1" colspan="2">
                            <list editable="bottom">
                                <field name="status"/>
                                <field name="procedure_id"/>
                                <field name="qty"/>
                                <field name="tooth"/>
                                <field name="note"/>
                            </list>
                        </field>
                    </group>
                    <group string="Time Tracking" col="4">
                        <field name="checkin_time"/>
                        <field name="waiting_minutes"/>
                        <field name="treat_start_time"/>
                        <field name="chair_minutes"/>
                        <field name="treat_end_time"/>
                        <field name="was_rescheduled" readonly="1"/>
                        <field name="duration_edited" readonly="1"/>
                    </group>
                    <group string="Previous Visit" invisible="not parent_appointment_id">
                        <field name="parent_appointment_id"/>
                        <field name="parent_visit_info" string="Date · Procedures"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- ===================== Appointment list ===================== -->
    <record id="view_clinic_appointment_list" model="ir.ui.view">
        <field name="name">clinic.appointment.list</field>
        <field name="model">calendar.event</field>
        <field name="priority">32</field>
        <field name="arch" type="xml">
            <list string="Appointments">
                <field name="start"/>
                <field name="patient_id"/>
                <field name="appointment_type_id"/>
                <field name="dentist_id"/>
                <field name="room_id"/>
                <field name="clinic_state" widget="badge"
                       decoration-info="clinic_state in ('confirmed','arrived')"
                       decoration-warning="clinic_state in ('booked','requested','in_progress')"
                       decoration-success="clinic_state in ('done','paid')"
                       decoration-danger="clinic_state in ('cancelled','no_show')"/>
            </list>
        </field>
    </record>

    <!-- ===================== Appointment calendar ===================== -->
    <record id="view_clinic_appointment_calendar" model="ir.ui.view">
        <field name="name">clinic.appointment.calendar</field>
        <field name="model">calendar.event</field>
        <field name="priority">32</field>
        <field name="arch" type="xml">
            <calendar string="Appointments" date_start="start" date_stop="stop"
                      color="appointment_type_id" mode="day" quick_create="0">
                <field name="patient_id" filters="1"/>
                <field name="dentist_id" filters="1" avatar_field="image_128"/>
                <field name="room_id" filters="1"/>
                <field name="appointment_type_id" filters="1"/>
                <field name="clinic_state"/>
            </calendar>
        </field>
    </record>

    <!-- ===================== Appointment search ===================== -->
    <record id="view_clinic_appointment_search" model="ir.ui.view">
        <field name="name">clinic.appointment.search</field>
        <field name="model">calendar.event</field>
        <field name="arch" type="xml">
            <search string="Appointments">
                <field name="patient_id"/>
                <field name="dentist_id"/>
                <field name="room_id"/>
                <filter name="my_appointments" string="My Appointments"
                        domain="[('dentist_id', '=', uid)]"/>
                <group>
                    <filter name="g_dentist" string="Dentist" domain="[]" context="{'group_by': 'dentist_id'}"/>
                    <filter name="g_room" string="Room" domain="[]" context="{'group_by': 'room_id'}"/>
                    <filter name="g_state" string="Status" domain="[]" context="{'group_by': 'clinic_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ===================== Appointment action ===================== -->
    <record id="action_clinic_appointment" model="ir.actions.act_window">
        <field name="name">Appointments</field>
        <field name="res_model">calendar.event</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="domain">[('is_clinic', '=', True)]</field>
        <field name="context">{'default_is_clinic': True}</field>
        <field name="search_view_id" ref="view_clinic_appointment_search"/>
    </record>
    <!-- Bind our primary views to this action -->
    <record id="action_clinic_appointment_view_calendar" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">calendar</field>
        <field name="view_id" ref="view_clinic_appointment_calendar"/>
        <field name="act_window_id" ref="action_clinic_appointment"/>
    </record>
    <record id="action_clinic_appointment_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_clinic_appointment_list"/>
        <field name="act_window_id" ref="action_clinic_appointment"/>
    </record>
    <!-- form uses the default (inherited) calendar.event form -->

    <!-- R11 — doctor's own calendar -->
    <record id="action_clinic_my_calendar" model="ir.actions.act_window">
        <field name="name">My Calendar</field>
        <field name="res_model">calendar.event</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="domain">[('is_clinic', '=', True), ('dentist_id', '=', uid)]</field>
        <field name="context">{'default_is_clinic': True, 'default_dentist_id': uid}</field>
        <field name="search_view_id" ref="view_clinic_appointment_search"/>
    </record>
    <record id="action_my_cal_view_calendar" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">calendar</field>
        <field name="view_id" ref="view_clinic_appointment_calendar"/>
        <field name="act_window_id" ref="action_clinic_my_calendar"/>
    </record>
    <record id="action_my_cal_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_clinic_appointment_list"/>
        <field name="act_window_id" ref="action_clinic_my_calendar"/>
    </record>

    <!-- ============ Visit history (board button: „ვიზიტების ისტორია") ============ -->
    <record id="view_clinic_visit_history_list" model="ir.ui.view">
        <field name="name">clinic.visit.history.list</field>
        <field name="model">calendar.event</field>
        <field name="priority">40</field>
        <field name="arch" type="xml">
            <list string="Visit History" default_order="start desc">
                <field name="start" string="Date"/>
                <field name="patient_id"/>
                <field name="dentist_id"/>
                <field name="name" string="Manipulation"/>
                <field name="diagnosis" optional="show"/>
                <field name="tooth_display" optional="show"/>
                <field name="clinic_state" widget="badge"
                       decoration-info="clinic_state in ('confirmed','arrived')"
                       decoration-warning="clinic_state in ('booked','requested','in_progress')"
                       decoration-success="clinic_state in ('done','paid')"
                       decoration-danger="clinic_state in ('cancelled','no_show')"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="amount_paid" widget="monetary" sum="Total Paid"/>
            </list>
        </field>
    </record>

    <record id="view_clinic_visit_history_search" model="ir.ui.view">
        <field name="name">clinic.visit.history.search</field>
        <field name="model">calendar.event</field>
        <field name="priority">40</field>
        <field name="arch" type="xml">
            <search string="Visit History">
                <field name="patient_id"/>
                <field name="dentist_id"/>
                <field name="diagnosis"/>
                <filter name="period_week" string="Last Week"
                        domain="[('start', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <filter name="period_2weeks" string="Last 2 Weeks"
                        domain="[('start', '&gt;=', (context_today() - datetime.timedelta(days=14)).strftime('%Y-%m-%d'))]"/>
                <filter name="period_month" string="Last Month"
                        domain="[('start', '&gt;=', (context_today() - datetime.timedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="f_done" string="Performed"
                        domain="[('clinic_state', 'in', ('done', 'paid'))]"/>
                <group>
                    <filter name="g_dentist" string="Dentist" domain="[]" context="{'group_by': 'dentist_id'}"/>
                    <filter name="g_date" string="Date" domain="[]" context="{'group_by': 'start:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_clinic_visit_history" model="ir.actions.act_window">
        <field name="name">Visit History</field>
        <field name="res_model">calendar.event</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_clinic', '=', True)]</field>
        <field name="view_id" ref="view_clinic_visit_history_list"/>
        <field name="search_view_id" ref="view_clinic_visit_history_search"/>
    </record>

    <!-- ====== Cancelled / rescheduled visits (board button: „გაუქმებულები") ====== -->
    <record id="view_clinic_visit_cancelled_list" model="ir.ui.view">
        <field name="name">clinic.visit.cancelled.list</field>
        <field name="model">calendar.event</field>
        <field name="priority">41</field>
        <field name="arch" type="xml">
            <list string="Cancelled / Rescheduled" default_order="start desc">
                <field name="start" string="Date"/>
                <field name="patient_id"/>
                <field name="dentist_id"/>
                <field name="name" string="Manipulation"/>
                <field name="clinic_state" widget="badge"
                       decoration-danger="clinic_state in ('cancelled','no_show')"
                       decoration-warning="clinic_state not in ('cancelled','no_show')"/>
                <field name="was_rescheduled"/>
                <field name="cancel_reason"/>
            </list>
        </field>
    </record>

    <record id="view_clinic_visit_cancelled_search" model="ir.ui.view">
        <field name="name">clinic.visit.cancelled.search</field>
        <field name="model">calendar.event</field>
        <field name="priority">41</field>
        <field name="arch" type="xml">
            <search string="Cancelled / Rescheduled">
                <field name="patient_id"/>
                <field name="dentist_id"/>
                <field name="start"/>
                <filter name="f_today" string="Today"
                        domain="[('start', '&gt;=', context_today().strftime('%Y-%m-%d')),
                                 ('start', '&lt;', (context_today() + datetime.timedelta(days=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="f_cancelled" string="Cancelled"
                        domain="[('clinic_state', 'in', ('cancelled', 'no_show'))]"/>
                <filter name="f_rescheduled" string="Rescheduled"
                        domain="[('was_rescheduled', '=', True)]"/>
                <group>
                    <filter name="g_dentist" string="Dentist" domain="[]" context="{'group_by': 'dentist_id'}"/>
                    <filter name="g_date" string="Date" domain="[]" context="{'group_by': 'start:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_clinic_visit_cancelled" model="ir.actions.act_window">
        <field name="name">Cancelled Visits</field>
        <field name="res_model">calendar.event</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_clinic', '=', True),
                              '|', ('clinic_state', 'in', ('cancelled', 'no_show')),
                                   ('was_rescheduled', '=', True)]</field>
        <field name="view_id" ref="view_clinic_visit_cancelled_list"/>
        <field name="search_view_id" ref="view_clinic_visit_cancelled_search"/>
    </record>

    <!-- ===================== Users: dentist's default room ===================== -->
    <record id="view_users_form_clinic" model="ir.ui.view">
        <field name="name">res.users.form.clinic</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="clinic_prefs" string="Clinic">
                    <group>
                        <field name="default_room_id"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- ===================== Rooms ===================== -->
    <record id="view_clinic_room_list" model="ir.ui.view">
        <field name="name">clinic.room.list</field>
        <field name="model">clinic.room</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="note"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="action_clinic_room" model="ir.actions.act_window">
        <field name="name">Rooms</field>
        <field name="res_model">clinic.room</field>
        <field name="view_mode">list</field>
    </record>

    <!-- ===================== Appointment types ===================== -->
    <record id="view_clinic_appointment_type_list" model="ir.ui.view">
        <field name="name">clinic.appointment.type.list</field>
        <field name="model">clinic.appointment.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="default_duration"/>
                <field name="procedure_id"/>
                <field name="color" widget="color_picker"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="action_clinic_appointment_type" model="ir.actions.act_window">
        <field name="name">Appointment Types</field>
        <field name="res_model">clinic.appointment.type</field>
        <field name="view_mode">list</field>
    </record>

    <!-- ===================== Menus (clinic staff only) =====================
         The custom Planning board is the calendar now, so the standard
         Appointments / My Calendar list menus are intentionally not exposed.
         The actions themselves stay defined (used by quick buttons / the board). -->
    <menuitem id="menu_clinic_rooms" name="Rooms"
              parent="menu_clinic_config" action="action_clinic_room" sequence="30"
              groups="clinic_patient_card.group_clinic_admin,clinic_patient_card.group_clinic_doctor"/>
    <menuitem id="menu_clinic_appointment_types" name="Appointment Types"
              parent="menu_clinic_config" action="action_clinic_appointment_type" sequence="40"
              groups="clinic_patient_card.group_clinic_admin,clinic_patient_card.group_clinic_doctor"/>

</odoo>
