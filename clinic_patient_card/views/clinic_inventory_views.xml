<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Supplies = storable products flagged is_clinic_supply -->
    <record id="view_clinic_supply_list" model="ir.ui.view">
        <field name="name">clinic.supply.product.list</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="default_code" optional="show"/>
                <field name="name"/>
                <field name="qty_available"/>
                <field name="standard_price"/>
                <field name="list_price"/>
                <field name="is_clinic_supply" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_clinic_supplies" model="ir.actions.act_window">
        <field name="name">Supplies</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_clinic_supply', '=', True)]</field>
        <field name="context">{'default_is_clinic_supply': True, 'default_type': 'consu', 'default_is_storable': True}</field>
        <field name="view_id" ref="view_clinic_supply_list"/>
    </record>

    <!-- Standard Purchase / Inventory screens, reused -->
    <record id="action_clinic_purchase_orders" model="ir.actions.act_window">
        <field name="name">Purchase Orders</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_clinic_replenishment" model="ir.actions.act_window">
        <field name="name">Replenishment</field>
        <field name="res_model">stock.warehouse.orderpoint</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_clinic_onhand" model="ir.actions.act_window">
        <field name="name">On-hand</field>
        <field name="res_model">stock.quant</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('location_id.usage', '=', 'internal')]</field>
    </record>

    <!-- Menus (clinic administrators — they have Purchase/Inventory access) -->
    <menuitem id="menu_clinic_inventory" name="Inventory"
              parent="menu_clinic_root" sequence="20"
              groups="clinic_patient_card.group_clinic_admin"/>
    <menuitem id="menu_clinic_supplies" name="Supplies"
              parent="menu_clinic_inventory" action="action_clinic_supplies" sequence="10"/>
    <menuitem id="menu_clinic_onhand" name="On-hand"
              parent="menu_clinic_inventory" action="action_clinic_onhand" sequence="20"/>
    <menuitem id="menu_clinic_replenishment" name="Replenishment"
              parent="menu_clinic_inventory" action="action_clinic_replenishment" sequence="30"/>
    <menuitem id="menu_clinic_purchase_orders" name="Purchase Orders"
              parent="menu_clinic_inventory" action="action_clinic_purchase_orders" sequence="40"/>

</odoo>
