<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Contact form: patient header (always visible) + Patient Card  -->
    <!-- as the FIRST tab, organised into 4 blocks                    -->
    <!-- ============================================================ -->
    <record id="view_partner_form_patient_card" model="ir.ui.view">
        <field name="name">res.partner.form.patient.card</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <!-- Remove the standard Tax ID from its default spot; re-added in
                 the header below as the personal number (single field). -->
            <xpath expr="//field[@name='vat']" position="replace"/>
            <!-- Soft-UI restyle hook: CSS-only redesign lives in
                 static/src/scss/clinic_partner_soft.scss -->
            <!-- the form compiler drops class attrs on <sheet>, so the hook
                 is an invisible marker div matched with :has() -->
            <!-- opened from a booking: one click (saves first) back to it -->
            <xpath expr="//sheet" position="before">
                <div class="px-3 pt-2"
                     invisible="not context.get('clinic_return_visit_id')">
                    <button name="action_back_to_visit" type="object"
                            string="← ჯავშანზე დაბრუნება"
                            class="btn-primary"
                            invisible="context.get('clinic_return_page')"/>
                    <button name="action_back_to_visit" type="object"
                            string="← ვიზიტის გვერდზე დაბრუნება"
                            class="btn-primary"
                            invisible="not context.get('clinic_return_page')"/>
                </div>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <div class="o_clinic_soft"/>
            </xpath>
            <!-- pregnant / allergic warning, same as on the booking popup -->
            <xpath expr="//sheet" position="before">
                <field name="health_pregnancy_alert" invisible="1"/>
                <field name="health_allergy_alert" invisible="1"/>
                <div class="d-flex flex-wrap gap-4 px-3 pt-2 align-items-center o_clinic_health_warn"
                     invisible="not is_patient or (not health_pregnancy_alert and not health_allergy_alert)">
                    <div class="d-flex align-items-center gap-2 text-danger fw-bold"
                         invisible="not health_pregnancy_alert">
                        <img src="/clinic_patient_card/static/src/img/pregnant.svg"
                             alt="ორსული" style="width:40px;height:40px;"/>
                        <span>პაციენტი ორსულია</span>
                    </div>
                    <div class="d-flex align-items-center gap-2 text-danger fw-bold"
                         invisible="not health_allergy_alert">
                        <img src="/clinic_patient_card/static/src/img/allergy.svg"
                             alt="ალერგია" style="width:40px;height:40px;"/>
                        <span>ალერგია: <field name="health_allergy_info" readonly="1" nolabel="1"
                                            class="d-inline fw-bold"/></span>
                    </div>
                </div>
            </xpath>
            <!-- Reviewer item 39 is handled globally: the form status
                 indicator (breadcrumb) renders labelled Save/Discard buttons
                 on every form, only while there is something to save — see
                 static/src/clinic_form_buttons.xml. -->

            <!-- The base "Contacts & Addresses" page is autofocused by default;
                 drop it so only the Patient Card page opens by default. -->
            <xpath expr="//page[@name='contact_addresses']" position="attributes">
                <attribute name="autofocus"/>
            </xpath>
            <!-- the standard "Notes" tab is not used on a patient (user 2026-10-07) -->
            <xpath expr="//page[@name='internal_notes']" position="attributes">
                <attribute name="invisible">is_patient</attribute>
            </xpath>

            <!-- "Contacts" tab for a patient = the people around them: guardian /
                 parent and family members (not phone numbers — those are in the card) -->
            <xpath expr="//page[@name='contact_addresses']" position="inside">
                <group string="მეურვე / მშობელი" invisible="not is_patient">
                    <field name="guardian_id" nolabel="1" colspan="2" readonly="1"
                           context="{'clinic_show_ids': 1}"/>
                </group>
                <group string="ოჯახის წევრები" invisible="not is_patient">
                    <field name="family_member_ids" nolabel="1" colspan="2"
                           context="{'clinic_show_ids': 1, 'default_is_patient': True}">
                        <list>
                            <field name="name"/>
                            <field name="birthdate"/>
                            <field name="phone"/>
                            <field name="vat"/>
                        </list>
                    </field>
                </group>
            </xpath>
            <xpath expr="//page[@name='contact_addresses']//field[@name='child_ids']" position="attributes">
                <attribute name="invisible">is_patient</attribute>
            </xpath>

            <!-- Meeting-style clutter is hidden for patients (reviewer):
                 job position, website, tags, company/individual switch. -->
            <xpath expr="//field[@name='function']" position="attributes">
                <attribute name="invisible">is_patient</attribute>
            </xpath>
            <xpath expr="//field[@name='website']" position="attributes">
                <attribute name="invisible">is_patient</attribute>
            </xpath>
            <xpath expr="//field[@name='category_id']" position="attributes">
                <attribute name="invisible">is_patient</attribute>
            </xpath>
            <!-- The Individual/Company toggle STAYS visible on patients too
                 (reviewer: "კომპანია არ გააუქმო მოსანიშნი — კლიენტია თუ
                 კომპანია"); only the company field reads as Workplace. -->
            <!-- "Company" reads as "Workplace" for a patient: hide the original
                 widget and offer a plain relabelled one in the header group
                 (a label can't be swapped conditionally on one field). -->
            <xpath expr="//field[@name='parent_id']" position="attributes">
                <attribute name="invisible">is_patient</attribute>
            </xpath>
            <!-- Patients only buy from us — the whole meeting-style Sales &amp;
                 Purchase tab is replaced for patients by a clean "რეალიზაცია"
                 page (below): create a sale order directly + see past sales.
                 Vendors/companies keep the standard tab. -->
            <xpath expr="//page[@name='sales_purchases']" position="attributes">
                <attribute name="invisible">is_patient</attribute>
            </xpath>
            <xpath expr="//page[@name='sales_purchases']" position="after">
                <page name="clinic_retail" string="რეალიზაცია" invisible="not is_patient">
                    <div class="d-flex gap-2 mb-3">
                        <button name="action_new_sale_order" type="object"
                                string="🪥 ახალი გაყიდვა" class="btn-primary"/>
                    </div>
                    <group>
                        <group string="Sale Defaults">
                            <field name="user_id" string="Salesperson"/>
                            <field name="property_payment_term_id"/>
                        </group>
                    </group>
                    <separator string="Sales History"/>
                    <field name="sale_order_ids" nolabel="1" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="date_order"/>
                            <field name="amount_total"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'sale'"
                                   decoration-info="state == 'draft'"
                                   decoration-danger="state == 'cancel'"/>
                        </list>
                    </field>
                </page>
            </xpath>

            <!-- the header phone is mandatory for a patient -->
            <xpath expr="(//field[@name='phone'])[1]" position="attributes">
                <attribute name="required">is_patient</attribute>
            </xpath>

            <!-- stat buttons (invoiced, meetings, purchases, lots/serials…) are
                 noise on a patient card -->
            <xpath expr="//div[@name='button_box']" position="attributes">
                <attribute name="invisible">is_patient</attribute>
            </xpath>

            <!-- A patient is always a person: no Individual/Company switch
                 (insurers / suppliers keep it). -->
            <xpath expr="//field[@name='company_type']" position="attributes">
                <attribute name="invisible">is_patient</attribute>
            </xpath>

            <!-- Header block: Personal No. (vat), birthdate, age, gender +
                 key patient fields the reviewer wants on the FIRST page:
                 workplace, insurance company, referral source. -->
            <xpath expr="//notebook" position="before">
                <group invisible="is_patient">
                    <group>
                        <field name="first_name" string="სახელი"
                               required="is_patient" invisible="not is_patient"/>
                        <field name="last_name" string="გვარი"
                               required="is_patient" invisible="not is_patient"/>
                        <field name="vat" string="Personal No." placeholder="digits only"
                               required="is_patient"/>
                        <field name="birthdate" placeholder="dd/mm/yyyy — can be typed"
                               required="is_patient"/>
                        <field name="age"/>
                        <field name="gender" widget="clinic_gender_icons"/>
                        <field name="parent_id" string="სამუშაო ადგილი"
                               invisible="not is_patient"/>
                    </group>
                    <group>
                        <!-- drives the visibility of every patient field; never shown
                             (2026-09-30, user: neither doctor nor admin sees it) —
                             new patients get it from the action/popup default -->
                        <field name="is_patient" invisible="1"/>
                        <field name="guardian_id" invisible="not is_minor"
                               required="is_minor"
                               context="{'clinic_show_ids': 1}"/>
                        <field name="patient_ref" invisible="not is_patient"/>
                        <field name="insurance_company_id" invisible="not is_patient"
                               domain="[('is_insurance_company', '=', True)]"
                               context="{'default_is_insurance_company': True, 'default_is_patient': False, 'default_company_type': 'company'}"/>
                        <field name="referral_source" invisible="not is_patient"
                               required="is_patient"/>
                        <field name="allergy_answer" string="ალერგია"
                               invisible="not is_patient" required="is_patient"/>
                        <field name="pregnancy_answer" string="ორსულობა"
                               invisible="not is_patient or gender != 'female'"
                               required="is_patient and gender == 'female'"/>
                        <field name="can_edit_medical" invisible="1"/>
                    </group>
                </group>
            </xpath>

            <!-- Patient Card page inserted BEFORE the first existing tab -->
            <xpath expr="//notebook/page[1]" position="before">
                <page name="patient_card" string="Patient Card"
                      autofocus="autofocus"
                      invisible="not is_patient">

                    <!-- Booking first (reviewer: the booking button must stand
                         out on the patient form) + card page / dashboard -->
                    <div class="d-flex gap-2 mb-2">
                        <button name="action_create_booking" type="object"
                                string="📅 დაჯავშნე" class="btn-primary"
                                invisible="not is_patient"/>
                    </div>

                    <!-- 1.9 Quick actions (placeholder buttons for now) -->
                    <div class="d-flex flex-wrap gap-1 mb-3 o_clinic_quick_btns" name="quick_actions">
                        <button name="action_clinic_todo" type="object"
                                string="Add Note" class="btn-secondary"/>
                        <button name="action_clinic_todo" type="object"
                                string="Send Reminder" class="btn-secondary"
                                groups="clinic_patient_card.group_clinic_admin"/>
                        <button name="action_clinic_todo" type="object"
                                string="Create Invoice" class="btn-secondary"
                                groups="clinic_patient_card.group_clinic_admin"/>
                        <button name="action_clinic_todo" type="object"
                                string="Generate Form-100" class="btn-secondary"/>
                        <button name="action_clinic_todo" type="object"
                                string="Sync EHR" class="btn-secondary"
                                groups="clinic_patient_card.group_clinic_doctor"/>
                        <button name="action_clinic_todo" type="object"
                                string="Make Payment / To Debt" class="btn-secondary"
                                groups="clinic_patient_card.group_clinic_admin"/>
                    </div>

                    <!-- the patient's identity block lives here, right under the
                         address and the tabs (user, 2026-10-02) -->
                        <group>
                            <group>
                                <field name="first_name" string="სახელი"
                                       required="is_patient" invisible="not is_patient"/>
                                <field name="last_name" string="გვარი"
                                       required="is_patient" invisible="not is_patient"/>
                                <field name="vat" string="Personal No." placeholder="digits only"
                                       required="is_patient"/>
                                <field name="birthdate" placeholder="dd/mm/yyyy — can be typed"
                                       required="is_patient"/>
                                <field name="age"/>
                                <field name="gender" widget="clinic_gender_icons"/>
                                <field name="parent_id" string="სამუშაო ადგილი"
                                       invisible="not is_patient"/>
                            </group>
                            <group>
                                <!-- drives the visibility of every patient field; never shown
                                     (2026-09-30, user: neither doctor nor admin sees it) —
                                     new patients get it from the action/popup default -->
                                <field name="guardian_id" invisible="not is_minor"
                                       required="is_minor"
                                       context="{'clinic_show_ids': 1}"/>
                                <field name="patient_ref" invisible="not is_patient"/>
                                <field name="insurance_company_id" invisible="not is_patient"
                                       domain="[('is_insurance_company', '=', True)]"
                                       context="{'default_is_insurance_company': True, 'default_is_patient': False, 'default_company_type': 'company'}"/>
                                <field name="referral_source" invisible="not is_patient"
                                       required="is_patient"/>
                                <field name="allergy_answer" string="ალერგია"
                                       invisible="not is_patient" required="is_patient"/>
                                <!-- upload the allergy test right here, whatever the answer -->
                                <field name="allergy_doc_count" invisible="1"/>
                                <widget name="clinic_allergy_upload" colspan="2"
                                        invisible="not is_patient or not allergy_answer"/>
                                <field name="pregnancy_answer" string="ორსულობა"
                                       invisible="not is_patient or gender != 'female'"
                                       required="is_patient and gender == 'female'"/>
                            </group>
                        </group>
                        <!-- allergy list: editable by admin AND doctor (it is required
                             when the answer is "yes") -->
                        <group invisible="not is_patient or allergy_answer != 'yes'">
                            <field name="allergy_ids" string="ალერგიები" colspan="2"
                                   required="allergy_answer == 'yes'">
                                <list editable="bottom">
                                    <field name="allergy_type"/>
                                    <field name="name"/>
                                    <field name="reaction"/>
                                    <field name="severity"/>
                                    <field name="test_done"/>
                                    <field name="test_result"/>
                                    <field name="note" optional="hide"/>
                                </list>
                            </field>
                        </group>
                        <!-- allergy test document: shown as soon as the allergy question is
                             answered (yes OR no); the same documents as the doctor's Medical
                             tab and the visit page (user 2026-10-07) -->
                        <group string="ალერგიული სინჯის საბუთი"
                               invisible="not is_patient or not allergy_answer">
                            <field name="allergy_doc_card_ids" colspan="2" nolabel="1"
                                   context="{'default_doc_type': 'allergy_doc'}">
                                <list editable="bottom">
                                    <field name="doc_type" column_invisible="1"/>
                                    <field name="attachment" filename="filename" widget="binary"
                                           string="ფაილი"/>
                                    <field name="filename" column_invisible="1"/>
                                    <field name="name" string="დასახელება"/>
                                    <field name="create_date" string="ატვირთვის დრო" readonly="1"/>
                                    <field name="uploaded_by_id" string="ვინ ატვირთა"/>
                                </list>
                            </field>
                        </group>


                    <!-- former "Basic" tab, now part of the card itself (user, 2026-10-02) -->
                    <group string="Basic Information">
                        <group>
                            <field name="name_latin" invisible="not is_foreign"/>
                            <field name="nationality_country_id" invisible="not is_foreign"/>
                            <field name="registration_date"/>
                            <field name="referral_source_other"
                                   invisible="referral_source != 'other'"/>
                        </group>
                        <group>
                            <field name="is_foreign"/>
                            <field name="is_first_visit"/>
                            <field name="is_repeat"/>
                            <field name="is_regular"/>
                            <field name="is_minor" readonly="1"/>
                        </group>
                    </group>

                    <group string="Contact Information">
                        <field name="patient_phone_ids" colspan="2" nolabel="1">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="is_primary"/>
                                <field name="phone"/>
                                <field name="country_code"/>
                                <field name="phone_type"/>
                                <field name="channel"/>
                                <field name="is_foreign_number"/>
                                <field name="is_emergency"/>
                                <field name="relation"/>
                                <field name="owner_name" optional="hide"/>
                                <field name="note" optional="hide"/>
                            </list>
                        </field>
                    </group>

                    <group string="Note">
                        <field name="patient_note" nolabel="1" colspan="2"
                               placeholder="Free note about the patient..."/>
                    </group>

                </page>
            </xpath>

            <!-- Medical + History tabs sit in the OUTER tab bar after Notes (user, 2026-10-02) -->
            <xpath expr="//page[@name='internal_notes']" position="after">
                <!-- Financial now sits in the OUTER tab bar next to Notes (user, 2026-10-05) -->
                <!-- BLOCK 3 — Financial (visible to clinic administrators) -->
                <page name="block_financial" string="Financial"
                      groups="clinic_patient_card.group_clinic_admin">
                    <group string="Financial Status">
                        <group string="Balance">
                            <field name="credit" string="Receivable (debt)"/>
                            <field name="debit" string="Payable (advance)"/>
                            <field name="total_invoiced"/>
                            <field name="property_payment_term_id"/>
                            <field name="preferred_payment_method"/>
                        </group>
                        <group string="Discounts and Loyalty">
                            <field name="discount_percent"/>
                            <field name="discount_fixed"/>
                            <field name="loyalty_status"/>
                        </group>
                        <group string="Insurance">
                            <field name="insurance_company_id"
                                   context="{'default_is_insurance_company': True, 'default_is_patient': False, 'default_company_type': 'company'}"/>
                            <field name="insurance_policy_no"/>
                            <field name="insurance_valid_until"/>
                            <field name="insurance_notes"/>
                        </group>
                        <separator string="Invoices and Payments" colspan="2"/>
                        <field name="invoice_ids" colspan="2" nolabel="1" readonly="1">
                            <list>
                                <field name="name"/>
                                <field name="invoice_date"/>
                                <field name="move_type"/>
                                <field name="amount_total"/>
                                <field name="payment_state"/>
                                <field name="state"/>
                            </list>
                        </field>
                    </group>
                </page>
                <!-- BLOCK 2 — Medical (editable by doctors only) -->
                <page name="block_medical" string="Medical" invisible="not is_patient"
                      groups="clinic_patient_card.group_clinic_doctor">
                    <group string="Medical History" readonly="not can_edit_medical">
                        <field name="anamnesis_general" colspan="2"/>
                        <group>
                            <field name="chronic_diseases"/>
                            <field name="current_medications"/>
                            <field name="family_history"/>
                        </group>
                        <group>
                            <field name="smoker"/>
                            <field name="alcohol"/>
                            <field name="has_bleeding_disorder"/>
                            <field name="has_cardio_risk"/>
                            <field name="medical_risk_notes"/>
                        </group>
                        <group string="Imaging (X-ray / CT)">
                            <field name="has_xray"/>
                            <field name="has_ct"/>
                            <field name="imaging_source"/>
                        </group>
                        <group string="ალერგიის საბუთები" colspan="2">
                            <field name="allergy_doc_ids" colspan="2" nolabel="1"
                                   context="{'default_doc_type': 'allergy_doc'}">
                                <list>
                                    <field name="name" string="დასახელება"/>
                                    <field name="attachment" filename="filename" widget="binary"
                                           string="ფაილი"/>
                                    <field name="filename" column_invisible="1"/>
                                    <field name="create_date" string="ატვირთვის დრო"/>
                                    <field name="uploaded_by_id" string="ვინ ატვირთა"/>
                                </list>
                                <form>
                                    <group>
                                        <field name="doc_type" invisible="1"/>
                                        <field name="name" string="დასახელება"/>
                                        <field name="attachment" filename="filename" widget="binary"
                                               string="ფაილი"/>
                                        <field name="filename" invisible="1"/>
                                        <field name="uploaded_by_id" string="ვინ ატვირთა" readonly="1"
                                               invisible="not id"/>
                                        <field name="create_date" string="ატვირთვის დრო" readonly="1"
                                               invisible="not id"/>
                                    </group>
                                </form>
                            </field>
                        </group>
                        <group string="გამოკვლევის შედეგები" colspan="2">
                            <field name="exam_result_ids" colspan="2" nolabel="1"
                                   context="{'default_doc_type': 'exam_result'}">
                                <list>
                                    <field name="name" string="დასახელება"/>
                                    <field name="result_text" string="შედეგი"/>
                                    <field name="attachment" filename="filename" widget="binary"
                                           string="ფაილი"/>
                                    <field name="filename" column_invisible="1"/>
                                    <field name="create_date" string="ატვირთვის დრო"/>
                                    <field name="uploaded_by_id" string="ვინ ატვირთა"/>
                                </list>
                                <form>
                                    <group>
                                        <field name="doc_type" invisible="1"/>
                                        <field name="name" string="დასახელება"/>
                                        <field name="result_text" string="შედეგი (ხელით შეყვანა)"
                                               placeholder="ჩაწერე გამოკვლევის შედეგი..."/>
                                        <field name="attachment" filename="filename" widget="binary"
                                               string="ფაილი"/>
                                        <field name="filename" invisible="1"/>
                                        <field name="uploaded_by_id" string="ვინ ატვირთა" readonly="1"
                                               invisible="not id"/>
                                        <field name="create_date" string="ატვირთვის დრო" readonly="1"
                                               invisible="not id"/>
                                    </group>
                                </form>
                            </field>
                        </group>
                        <group string="X-ray / Photos" colspan="2">
                            <field name="xray_ids" colspan="2" nolabel="1" mode="kanban"
                                   context="{'default_doc_type': 'xray'}">
                                <kanban>
                                    <field name="name"/>
                                            <field name="create_date"/>
                                    <field name="uploaded_by_id"/>
                                    <field name="note"/>
                                    <field name="write_date"/>
                                    <field name="attachment"/>
                                    <templates>
                                        <t t-name="card">
                                            <field name="attachment" widget="clinic_zoom_image"
                                                   options="{'size': [0, 150]}"/>
                                            <div class="fw-bold mt-1"><field name="name"/></div>
                                            <div class="text-muted small">
                                                ⬆ <field name="create_date"/>
                                                · <field name="uploaded_by_id"/>
                                            </div>
                                            <div class="small" t-if="record.note.raw_value">
                                                <field name="note"/>
                                            </div>
                                            <div class="mt-1 d-flex gap-2">
                                                <button name="action_open_full" type="object"
                                                        class="btn btn-sm btn-link p-0">💬 კომენტარები</button>
                                                <a type="delete" class="text-danger">🗑 წაშლა</a>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                                <form>
                                    <group>
                                        <field name="name"/>
                                                    <field name="attachment" filename="filename" widget="clinic_image_upload"
                                               options="{'size': [0, 300]}"/>
                                        <field name="filename" invisible="1"/>
                                        <field name="note"/>
                                        <field name="doc_type" invisible="1"/>
                                    </group>
                                </form>
                            </field>
                        </group>
                        <group string="Last Update" col="2">
                            <field name="medical_update_date"/>
                            <field name="medical_update_uid"/>
                        </group>
                    </group>

                    <group string="Dental" readonly="not can_edit_medical">
                        <group>
                            <field name="last_dental_visit_date"/>
                            <field name="treatment_plan_status" widget="badge"
                                   decoration-success="treatment_plan_status == 'in_progress'"
                                   decoration-warning="treatment_plan_status == 'planned'"
                                   decoration-danger="treatment_plan_status in ('postponed','cancelled')"/>
                        </group>
                        <group>
                            <field name="has_bruxism"/>
                            <field name="periodontitis_risk"/>
                        </group>
                        <field name="dental_other_notes" colspan="2"/>
                        <separator string="Dental Chart (FDI)" colspan="2"/>
                        <!-- chart + the table of the SAME procedure rows (added on the chart,
                             in the table or on the visit page — all three stay in sync) -->
                        <widget name="clinic_tooth_chart" colspan="2"/>
                        <!-- old manual per-tooth statuses: kept (still drawn as a low-priority fallback) -->
                        <separator string="ხელით მითითებული სტატუსები (ძველი)" colspan="2"/>
                        <field name="tooth_ids" colspan="2" nolabel="1">
                            <list editable="bottom">
                                <field name="tooth_number"/>
                                <field name="status"/>
                                <field name="note"/>
                            </list>
                        </field>
                        <!-- D-48: periodontal chart (Bern-style), one record per examination -->
                        <separator string="პაროდონტოლოგიური სქემა" colspan="2"/>
                        <widget name="clinic_perio_chart" colspan="2"/>
                    </group>
                </page>

                <!-- BLOCK 4 — History -->
                <page name="block_history" string="History" invisible="not is_patient">
                    <!-- visits, each opening its Dentos-style page -->
                    <group string="ვიზიტები">
                        <field name="clinic_visit_ids" colspan="2"
                               nolabel="1" readonly="1">
                            <list default_order="start desc">
                                <field name="start"/>
                                <field name="dentist_id"/>
                                <field name="appointment_type_id"/>
                                <field name="clinic_state" widget="badge"
                                       decoration-success="clinic_state in ('done','paid')"
                                       decoration-info="clinic_state in ('confirmed','arrived','in_progress')"
                                       decoration-warning="clinic_state in ('booked','requested')"
                                       decoration-danger="clinic_state in ('cancelled','no_show')"/>
                                <field name="amount_paid" optional="show"/>
                                <button name="action_open_visit_page"
                                        type="object" string="🧾 გვერდი"
                                        class="btn-link"
                                        invisible="clinic_state not in ('arrived', 'in_progress', 'done', 'paid')"/>
                            </list>
                        </field>
                    </group>
                    <!-- the separate procedures table is gone —
                         procedures live on each visit's page now,
                         reachable from the ვიზიტები list above -->
                    <group string="Documents">
                        <field name="document_ids" colspan="2" nolabel="1">
                            <list>
                                <field name="doc_type"/>
                                <field name="name"/>
                                <field name="date"/>
                                <field name="attachment" filename="filename" widget="binary"/>
                                <field name="filename" column_invisible="1"/>
                                <field name="note"/>
                            </list>
                            <form>
                                <group>
                                    <group>
                                        <field name="doc_type"/>
                                        <field name="name"/>
                                        <field name="date"/>
                                        <field name="attachment" filename="filename" widget="binary"/>
                                        <field name="filename" invisible="1"/>
                                        <field name="note"/>
                                    </group>
                                </group>
                                <separator string="Signature"
                                           invisible="doc_type != 'consent'"/>
                                <field name="signature" widget="signature"
                                       invisible="doc_type != 'consent'"/>
                            </form>
                        </field>
                    </group>

                    <group string="Patient Profile">
                        <group>
                            <field name="no_show_rate"/>
                            <field name="ltv_forecast"/>
                        </group>
                        <group>
                            <field name="risk_level"/>
                            <field name="risk_notes"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Address block of the partner form. Separate view with a later
         priority: the city_id field is added by base_address_extended's own
         inherit (priority 16, loaded after ours), so it must be patched after. -->
    <record id="view_partner_form_patient_address" model="ir.ui.view">
        <field name="name">res.partner.form.patient.address</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <!-- "Partner Assignment" (geolocation) tab: pulled in by the standard
                 base_geolocalize when hr_attendance was installed — not a clinic feature -->
            <xpath expr="//page[@name='geo_location']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- Address block: street = residence, street 2 = legal address,
                 city picked from the (standard res.city) list with Create;
                 state hidden; ZIP + country only for non-residents. -->
            <xpath expr="//div[hasclass('o_address_format')]/field[@name='street']"
                   position="attributes">
                <attribute name="placeholder">საცხოვრებელი მისამართი</attribute>
            </xpath>
            <xpath expr="//div[hasclass('o_address_format')]/field[@name='street2']"
                   position="attributes">
                <attribute name="placeholder">იურიდიული მისამართი</attribute>
            </xpath>
            <xpath expr="//div[hasclass('o_address_format')]/field[@name='city_id']"
                   position="attributes">
                <attribute name="placeholder">ქალაქი</attribute>
                <attribute name="invisible">not is_patient and not country_enforce_cities</attribute>
                <attribute name="domain">[]</attribute>
                <attribute name="context">{'default_country_id': %(base.ge)d}</attribute>
            </xpath>
            <xpath expr="//div[hasclass('o_address_format')]/field[@name='city']"
                   position="attributes">
                <attribute name="invisible">is_patient or (country_enforce_cities and (city_id or city in ('', False)))</attribute>
            </xpath>
            <xpath expr="//div[hasclass('o_address_format')]/field[@name='state_id']"
                   position="attributes">
                <attribute name="invisible">is_patient</attribute>
            </xpath>
            <xpath expr="//div[hasclass('o_address_format')]/field[@name='zip']"
                   position="attributes">
                <attribute name="invisible">is_patient and not is_foreign</attribute>
            </xpath>
            <xpath expr="//div[hasclass('o_address_format')]//field[@name='country_id']"
                   position="attributes">
                <attribute name="invisible">is_patient and not is_foreign</attribute>
            </xpath>
        </field>
    </record>

    <!-- New contacts made from the Contacts app are patients by default
         (reviewer: drop the "Is a Patient" checkbox). Vendors, insurance
         companies and user partners are created through their own flows,
         which set their own flags. -->
    <record id="contacts.action_contacts" model="ir.actions.act_window">
        <field name="context">{'default_is_patient': True}</field>
    </record>

    <!-- ============================================================ -->
    <!-- Patient quick-registration popup (Dentos-style) — opened from
         the booking form's Patient field via form_view_ref, so a new
         patient is registered without leaving the booking dialog.     -->
    <!-- ============================================================ -->
    <record id="view_clinic_patient_quick_form" model="ir.ui.view">
        <field name="name">res.partner.form.clinic.quick.registration</field>
        <field name="model">res.partner</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form string="პაციენტის რეგისტრაციის ფორმა">
                <sheet>
                    <!-- First-visit registration from the booking: only first
                         name, last name, mobile (+ insurance, optional birth
                         date with the age). The rest — personal no., referral source (required),
                         gender, foreign data, health — is filled on the
                         patient card when the patient arrives. -->
                    <div class="alert alert-light d-flex align-items-center gap-2 mb-3"
                         role="none" style="border:1px solid #e5e8ec; border-radius:12px;">
                        <field name="is_foreign" widget="boolean_toggle" nolabel="1"/>
                        <b>უცხო ქვეყნის მოქალაქე</b>
                    </div>
                    <field name="is_patient" invisible="1"/>
                    <group>
                        <group>
                            <field name="first_name" required="1"
                                   string="სახელი"/>
                            <field name="last_name" required="1"
                                   string="გვარი"/>
                            <field name="name_latin" string="სახელი და გვარი (ლათინურად)"
                                   invisible="not is_foreign" required="is_foreign"/>
                            <!-- optional here; the age is counted at once -->
                            <field name="birthdate" string="დაბადების თარიღი"/>
                            <field name="age" string="ასაკი" invisible="not birthdate"/>
                        </group>
                        <group>
                            <field name="phone" required="1"
                                   string="მობილური"/>
                            <field name="insurance_company_id"
                                   string="დაზღვევა"
                                   context="{'default_is_insurance_company': True, 'default_is_patient': False, 'default_company_type': 'company'}"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Search: filter patients                                       -->
    <!-- ============================================================ -->
    <record id="view_res_partner_filter_patient" model="ir.ui.view">
        <field name="name">res.partner.search.patient</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="filter_is_patient" string="Patients"
                        domain="[('is_patient', '=', True)]"/>
            </xpath>
        </field>
    </record>

</odoo>
