<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_clinic_supply_shop" model="ir.actions.client">
        <field name="name">Supply Shop</field>
        <field name="tag">clinic_supply_shop</field>
    </record>

    <menuitem id="menu_clinic_supply_shop" name="Supply Shop"
              parent="menu_clinic_root" action="action_clinic_supply_shop" sequence="15"
              groups="clinic_patient_card.group_clinic_admin"/>

    <!-- Supplier side: publish products + see own orders -->
    <record id="action_clinic_supplier_portal" model="ir.actions.client">
        <field name="name">My Products</field>
        <field name="tag">clinic_supplier_portal</field>
    </record>

    <menuitem id="menu_clinic_supplier_portal" name="My Shop"
              parent="menu_clinic_root" action="action_clinic_supplier_portal" sequence="16"
              groups="clinic_patient_card.group_clinic_supplier"/>

    <!-- Suppliers reach their (scoped) stock straight from standard Inventory,
         which is the base for the products they manage in "My Shop". -->
    <record id="action_clinic_supplier_inventory" model="ir.actions.act_window">
        <field name="name">My Inventory</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('is_clinic_supply', '=', True), ('seller_ids.partner_id.commercial_partner_id.user_ids', 'in', [uid])]</field>
    </record>
    <menuitem id="menu_clinic_supplier_inventory" name="My Inventory"
              parent="menu_clinic_root" action="action_clinic_supplier_inventory"
              sequence="17" groups="clinic_patient_card.group_clinic_supplier"/>

    <!-- Clinic orders reach the supplier as their own sales orders to fulfil. -->
    <record id="action_clinic_supplier_orders" model="ir.actions.act_window">
        <field name="name">My Orders</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_clinic_order', '=', True)]</field>
    </record>
    <menuitem id="menu_clinic_supplier_orders" name="My Orders"
              parent="menu_clinic_root" action="action_clinic_supplier_orders"
              sequence="18" groups="clinic_patient_card.group_clinic_supplier"/>

    <!-- ============ Supplier's own warehouse (v19.0.54) ============ -->
    <record id="view_clinic_supplier_quant_list" model="ir.ui.view">
        <field name="name">clinic.supplier.quant.list</field>
        <field name="model">stock.quant</field>
        <field name="priority">80</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="1" delete="0">
                <field name="product_id"/>
                <field name="location_id" readonly="1" force_save="1" optional="show"/>
                <field name="quantity" readonly="1" string="On Hand"/>
                <field name="inventory_quantity" string="Counted Qty"/>
                <button name="action_apply_inventory" type="object"
                        string="Apply" class="btn-primary btn-sm"/>
            </list>
        </field>
    </record>
    <!-- read-only movement history for the supplier: no form view on
         purpose — a picking form would expose Validate on the CLINIC's
         receipt (მიღებას მხოლოდ კლინიკა ადასტურებს) -->
    <record id="view_clinic_supplier_picking_list" model="ir.ui.view">
        <field name="name">clinic.supplier.picking.list</field>
        <field name="model">stock.picking</field>
        <field name="priority">80</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" default_order="id desc">
                <field name="name"/>
                <field name="origin" optional="show"/>
                <field name="location_id" string="From"/>
                <field name="location_dest_id" string="To"/>
                <field name="scheduled_date" optional="hide"/>
                <field name="date_done"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('assigned', 'confirmed')"
                       decoration-danger="state == 'cancel'"/>
            </list>
        </field>
    </record>
    <record id="action_clinic_my_transfers" model="ir.actions.server">
        <field name="name">My Transfers</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">action = model.clinic_my_transfers_action()</field>
        <field name="group_ids" eval="[(4, ref('group_clinic_supplier'))]"/>
    </record>
    <menuitem id="menu_clinic_supplier_transfers" name="My Transfers"
              parent="menu_clinic_root" action="action_clinic_my_transfers"
              sequence="18" groups="clinic_patient_card.group_clinic_supplier"/>

    <record id="action_clinic_my_warehouse" model="ir.actions.server">
        <field name="name">My Warehouse</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">action = model.clinic_my_warehouse_action()</field>
        <!-- without groups_id only admins may run a server action from a menu -->
        <field name="group_ids" eval="[(4, ref('group_clinic_supplier'))]"/>
    </record>
    <menuitem id="menu_clinic_supplier_warehouse" name="My Warehouse"
              parent="menu_clinic_root" action="action_clinic_my_warehouse"
              sequence="17" groups="clinic_patient_card.group_clinic_supplier"/>

    <!-- ============ Shop v2 (batch #2) ============ -->
    <record id="view_clinic_shop_banner_list" model="ir.ui.view">
        <field name="name">clinic.shop.banner.list</field>
        <field name="model">clinic.shop.banner</field>
        <field name="arch" type="xml">
            <list editable="bottom" open_form_view="1">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="note"/>
                <field name="link_url" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="view_clinic_shop_banner_form" model="ir.ui.view">
        <field name="name">clinic.shop.banner.form</field>
        <field name="model">clinic.shop.banner</field>
        <field name="arch" type="xml">
            <form string="Shop Banner">
                <group>
                    <group>
                        <field name="name"/>
                        <field name="note"/>
                        <field name="link_url" placeholder="https://..."/>
                        <field name="show_text"/>
                        <field name="active" widget="boolean_toggle"/>
                    </group>
                    <group>
                        <field name="image" widget="image"/>
                    </group>
                </group>
            </form>
        </field>
    </record>
    <record id="action_clinic_shop_banner" model="ir.actions.act_window">
        <field name="name">Shop Banners</field>
        <field name="res_model">clinic.shop.banner</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_clinic_shop_banners" name="Shop Banners"
              parent="menu_clinic_config" action="action_clinic_shop_banner" sequence="26"
              groups="clinic_patient_card.group_clinic_admin"/>

    <!-- Sponsored management: the clinic sees/toggles its sponsored products
         in one editable list (reviewer: "კლინიკა ვერ ხედავს თავის
         დასპონსორებულებს"). -->
    <record id="view_clinic_sponsored_list" model="ir.ui.view">
        <field name="name">clinic.sponsored.product.list</field>
        <field name="model">product.template</field>
        <field name="priority">60</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="0" delete="0">
                <field name="name" readonly="1"/>
                <field name="categ_id" readonly="1"/>
                <field name="clinic_brand_id" readonly="1"/>
                <field name="clinic_sponsored" widget="boolean_toggle"/>
                <field name="clinic_preorder" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="view_clinic_sponsored_search" model="ir.ui.view">
        <field name="name">clinic.sponsored.product.search</field>
        <field name="model">product.template</field>
        <field name="priority">60</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="f_sponsored" string="Sponsored"
                        domain="[('clinic_sponsored', '=', True)]"/>
                <filter name="f_preorder" string="Pre-order"
                        domain="[('clinic_preorder', '=', True)]"/>
            </search>
        </field>
    </record>
    <record id="action_clinic_sponsored" model="ir.actions.act_window">
        <field name="name">Sponsored Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list</field>
        <field name="domain">[('is_clinic_supply', '=', True)]</field>
        <field name="view_id" ref="view_clinic_sponsored_list"/>
        <field name="search_view_id" ref="view_clinic_sponsored_search"/>
    </record>
    <menuitem id="menu_clinic_sponsored" name="Sponsored Products"
              parent="menu_clinic_config" action="action_clinic_sponsored" sequence="28"
              groups="clinic_patient_card.group_clinic_admin"/>

    <!-- Shop categories reachable straight from the Clinic menu (reviewer:
         "სად ვამატებ კატეგორიებს" — no need to hunt in Inventory). -->
    <record id="action_clinic_product_categories" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">product.category</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_clinic_product_categories" name="Categories"
              parent="menu_clinic_config" action="action_clinic_product_categories" sequence="27"
              groups="clinic_patient_card.group_clinic_admin"/>

    <!-- category photo (storefront tiles) -->
    <record id="view_product_category_form_clinic" model="ir.ui.view">
        <field name="name">product.category.form.clinic.image</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <field name="parent_id" position="after">
                <field name="image_128" widget="image" class="oe_avatar"/>
                <field name="clinic_shop_visible"/>
            </field>
        </field>
    </record>
</odoo>
