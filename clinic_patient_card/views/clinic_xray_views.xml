<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Full page of one X-ray / photo: details + comments (standard chatter) -->
    <record id="view_clinic_xray_form" model="ir.ui.view">
        <field name="name">clinic.patient.document.xray.form</field>
        <field name="model">clinic.patient.document</field>
        <field name="arch" type="xml">
            <form string="X-ray / Photo">
                <header>
                    <button name="action_add_next" type="object" class="btn-primary"
                            string="➕ შემდეგი სურათი" invisible="not id or not attachment"/>

                </header>
                <sheet>
                    <!-- empty image widget = the upload (pencil) button; filled = the picture -->
                    <field name="attachment" widget="clinic_image_upload" filename="filename"
                           options="{'size': [0, 420]}"/>
                    <group>
                        <group>
                            <field name="partner_id" readonly="id" domain="[('is_patient', '=', True)]"
                                   options="{'no_create': True}"/>
                            <field name="doc_type"/>
                            <field name="name"/>
                            <field name="note"/>
                        </group>
                        <group>
                            <field name="create_date" string="Uploaded at" readonly="1"/>
                            <field name="uploaded_by_id"/>
                            <field name="filename" invisible="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
                <footer>
                    <button string="← უკან" special="cancel" class="btn-primary"/>
                    <button string="შენახვა" special="save" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Radiology: the radiologist uploads the pictures taken for a patient -->
    <record id="view_clinic_xray_list" model="ir.ui.view">
        <field name="name">clinic.patient.document.xray.list</field>
        <field name="model">clinic.patient.document</field>
        <field name="arch" type="xml">
            <list>
                <field name="partner_id"/>
                <field name="name"/>
                <field name="create_date" string="Uploaded at"/>
                <field name="uploaded_by_id"/>
                <field name="note" optional="show"/>
            </list>
        </field>
    </record>

    <record id="action_clinic_radiology" model="ir.actions.act_window">
        <field name="name">X-ray uploads</field>
        <field name="res_model">clinic.patient.document</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('doc_type', '=', 'xray')]</field>
        <field name="context">{'default_doc_type': 'xray'}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_clinic_xray_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_clinic_xray_form')})]"/>
    </record>

    <menuitem id="menu_clinic_radiology_root" name="Radiology" sequence="91"
              groups="clinic_patient_card.group_clinic_radiologist,clinic_patient_card.group_clinic_admin"/>
    <menuitem id="menu_clinic_radiology_patients" name="Patients"
              parent="menu_clinic_radiology_root" action="action_clinic_patients" sequence="0"
              groups="clinic_patient_card.group_clinic_radiologist"/>
    <menuitem id="menu_clinic_radiology" name="X-ray uploads"
              parent="menu_clinic_radiology_root" action="action_clinic_radiology" sequence="1"/>

</odoo>
