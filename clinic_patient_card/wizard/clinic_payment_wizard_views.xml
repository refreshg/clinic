<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_clinic_payment_wizard_form" model="ir.ui.view">
        <field name="name">clinic.payment.wizard.form</field>
        <field name="model">clinic.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Register Payment">
                <field name="appointment_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <group>
                    <group>
                        <field name="partner_id"/>
                        <field name="payment_method"/>
                        <field name="note"/>
                    </group>
                    <group>
                        <field name="amount_total" widget="monetary" class="oe_inline"/>
                    </group>
                </group>
                <separator string="Procedures"/>
                <field name="summary"/>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm Payment"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
