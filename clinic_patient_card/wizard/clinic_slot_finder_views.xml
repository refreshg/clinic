<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_clinic_slot_finder_form" model="ir.ui.view">
        <field name="name">clinic.slot.finder.form</field>
        <field name="model">clinic.slot.finder</field>
        <field name="arch" type="xml">
            <form string="Free Slots">
                <group col="4">
                    <field name="event_id" invisible="1"/>
                    <field name="direction_id"/>
                    <field name="duration" widget="float_time"/>
                    <field name="date_from"/>
                    <button name="action_search" type="object" string="🔍 Search"
                            class="btn-primary"/>
                </group>
                <div class="alert alert-warning" role="alert" invisible="not message">
                    <field name="message" nolabel="1"/>
                </div>
                <field name="line_ids" nolabel="1" readonly="1">
                    <list create="0" delete="0" limit="40">
                        <field name="start" string="Time"/>
                        <field name="dentist_id"/>
                        <field name="room"/>
                        <button name="action_pick" type="object" string="აირჩიე"
                                class="btn-primary btn-sm"/>
                    </list>
                </field>
                <footer>
                    <button name="action_close" type="object" string="Back"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
