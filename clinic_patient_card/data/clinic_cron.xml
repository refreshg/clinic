<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_clinic_low_stock" model="ir.cron">
        <field name="name">Clinic: low-stock alert</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="state">code</field>
        <field name="code">model._clinic_notify_low_stock()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <!-- Dispensary control reminders: 2 weeks before the reserve visit the
         administrators get a to-do ("call the patient") + a live toast. -->
    <record id="cron_clinic_dispensary" model="ir.cron">
        <field name="name">Clinic: dispensary call reminders</field>
        <field name="model_id" ref="calendar.model_calendar_event"/>
        <field name="state">code</field>
        <field name="code">model._cron_dispensary_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <!-- A pregnancy answer is for one visit day only: the next day it is forgotten
         and the patient is asked again. Allergy answers: after 6 months (D-44). -->
    <record id="cron_clinic_reset_pregnancy" model="ir.cron">
        <field name="name">Clinic: forget stale pregnancy (1 day) / allergy (6 months) answers</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">model._cron_reset_stale_pregnancy()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <!-- Weekly booking summary for the administrators (the "manager"). -->
    <record id="cron_clinic_booking_report" model="ir.cron">
        <field name="name">Clinic: weekly booking report</field>
        <field name="model_id" ref="calendar.model_calendar_event"/>
        <field name="state">code</field>
        <field name="code">model._cron_booking_report()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="active" eval="True"/>
    </record>

    <!-- D-44: existing allergy answers get today's stamp (idempotent) -->
    <function model="res.partner" name="_clinic_stamp_allergy_answers"/>

    <!-- D-45: completed visits needed for "Regular Patient" — temporary 5 until
         the clinic decides; editable in Settings > Technical > System Parameters
         (then run the recount below again via an upgrade) -->
    <data noupdate="1">
        <record id="param_regular_patient_visits" model="ir.config_parameter">
            <field name="key">clinic.regular_patient_visits</field>
            <field name="value">5</field>
        </record>
    </data>
    <function model="res.partner" name="_clinic_recompute_visit_flags"/>

    <!-- D-47: link the visit rows already on file to the treatment-plan rows (idempotent) -->
    <function model="clinic.procedure.history" name="_clinic_link_existing_plans"/>
</odoo>
