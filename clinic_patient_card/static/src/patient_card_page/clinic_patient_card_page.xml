<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- ===== lucide icons (stroke 1.5) as reusable sub-templates ===== -->
    <t t-name="clinic_patient_card.ic_bell">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10.268 21a2 2 0 0 0 3.464 0"/><path d="M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326"/></svg>
    </t>
    <t t-name="clinic_patient_card.ic_user">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
    </t>
    <t t-name="clinic_patient_card.ic_file">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>
    </t>
    <t t-name="clinic_patient_card.ic_chart">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v16a2 2 0 0 0 2 2h16"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/></svg>
    </t>
    <t t-name="clinic_patient_card.ic_calendar">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
    </t>
    <t t-name="clinic_patient_card.ic_logout">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="m16 17 5-5-5-5"/><path d="M21 12H9"/></svg>
    </t>
    <t t-name="clinic_patient_card.ic_search">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
    </t>
    <t t-name="clinic_patient_card.ic_plus">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
    </t>
    <t t-name="clinic_patient_card.ic_check">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
    </t>
    <t t-name="clinic_patient_card.ic_x">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    </t>
    <t t-name="clinic_patient_card.ic_filetext">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M16 13H8"/><path d="M16 17H8"/><path d="M10 9H8"/></svg>
    </t>

    <!-- small helper: 20x20 checkbox -->
    <t t-name="clinic_patient_card.checkbox">
        <span t-attf-class="cpc_box {{ on ? 'on' : '' }}">
            <t t-if="on"><t t-call="clinic_patient_card.ic_check"/></t>
        </span>
    </t>

    <!-- ===== main page ===== -->
    <t t-name="clinic_patient_card.ClinicPatientCardPage">
        <div class="cpc">
            <div class="cpc_app">

                <!-- sidebar -->
                <div class="cpc_side">
                    <div class="cpc_rail">
                        <t t-foreach="nav" t-as="n" t-key="n.id">
                            <button t-attf-class="cpc_nav {{ state.navActive === n.id ? 'on' : '' }}"
                                    t-att-title="n.title" t-on-click="() => this.setNav(n.id)">
                                <t t-if="n.icon === 'bell'"><t t-call="clinic_patient_card.ic_bell"/></t>
                                <t t-elif="n.icon === 'user'"><t t-call="clinic_patient_card.ic_user"/></t>
                                <t t-elif="n.icon === 'file'"><t t-call="clinic_patient_card.ic_file"/></t>
                                <t t-elif="n.icon === 'chart'"><t t-call="clinic_patient_card.ic_chart"/></t>
                                <t t-else=""><t t-call="clinic_patient_card.ic_calendar"/></t>
                            </button>
                        </t>
                        <div class="cpc_nav_gap"/>
                        <button class="cpc_nav" t-att-title="'გასვლა'"><t t-call="clinic_patient_card.ic_logout"/></button>
                    </div>
                </div>

                <!-- main -->
                <div class="cpc_main">
                    <t t-if="state.loading">
                        <div class="cpc_empty">Loading…</div>
                    </t>
                    <t t-elif="!state.data">
                        <div class="cpc_empty">No patient selected.</div>
                    </t>
                    <t t-else="">
                        <!-- top bar -->
                        <div class="cpc_top">
                            <div>
                                <div class="cpc_kicker">დენტა კლინიკა</div>
                                <h2 class="cpc_h1">პაციენტის ბარათი</h2>
                            </div>
                            <div class="cpc_top_right">
                                <div class="cpc_search">
                                    <t t-call="clinic_patient_card.ic_search"/>
                                    <input type="text" placeholder="ძებნა…" t-att-value="state.search"
                                           t-on-input="(ev) => this.onSearch(ev)"/>
                                </div>
                                <button class="cpc_btn_primary" t-on-click="() => this.newVisit()">
                                    <t t-call="clinic_patient_card.ic_plus"/> ახალი ვიზიტი
                                </button>
                            </div>
                        </div>

                        <!-- hero -->
                        <div class="cpc_hero">
                            <div class="cpc_avatar" t-esc="state.data.initials"/>
                            <div class="cpc_hero_mid">
                                <div class="cpc_hero_name">
                                    <b t-esc="state.data.name"/>
                                    <span t-if="state.data.isRepeat" class="cpc_chip_pink">განმეორებითი</span>
                                    <span class="cpc_chip_glass" t-esc="state.data.ref"/>
                                </div>
                                <div class="cpc_meta">
                                    <span><t t-esc="state.data.birthDate"/> · <t t-esc="state.data.age"/> წ.</span>
                                    <span>პ/ნ <t t-esc="state.data.personalNo"/></span>
                                    <span t-esc="state.data.phone"/>
                                    <span t-esc="state.data.email"/>
                                </div>
                                <div class="cpc_meta2">
                                    <t t-esc="state.data.address"/> · წყარო: <t t-esc="state.data.referralSource"/> · რეგ. <t t-esc="state.data.registeredAt"/>
                                </div>
                            </div>
                            <div class="cpc_hero_stats">
                                <div><div class="cpc_stat_l">დავალიანება</div><div class="cpc_stat_v" t-esc="state.data.debt"/></div>
                                <div><div class="cpc_stat_l">ბოლო ვიზიტი</div><div class="cpc_stat_v" t-esc="state.data.lastVisitShort"/></div>
                            </div>
                        </div>

                        <!-- pill tabs -->
                        <div class="cpc_tabs">
                            <button t-attf-class="cpc_tab {{ state.tab === 'main' ? 'on' : '' }}" t-on-click="() => this.setTab('main')">ძირითადი</button>
                            <button t-attf-class="cpc_tab {{ state.tab === 'med' ? 'on' : '' }}" t-on-click="() => this.setTab('med')">სამედიცინო</button>
                            <button t-attf-class="cpc_tab {{ state.tab === 'fin' ? 'on' : '' }}" t-on-click="() => this.setTab('fin')">ფინანსური</button>
                            <button t-attf-class="cpc_tab {{ state.tab === 'hist' ? 'on' : '' }}" t-on-click="() => this.setTab('hist')">ისტორია</button>
                        </div>

                        <!-- ═══ TAB main ═══ -->
                        <t t-if="state.tab === 'main'">
                            <div class="cpc_col">
                                <div class="cpc_g2">
                                    <div class="cpc_card">
                                        <div class="cpc_card_t">ძირითადი ინფორმაცია</div>
                                        <div class="cpc_lv">
                                            <span class="l">სახელი (ლათინურად)</span><span class="v" t-esc="state.data.latinName"/>
                                            <span class="l">მოქალაქეობა</span><span class="v" t-esc="state.data.citizenship"/>
                                            <span class="l">სქესი</span><span class="v" t-esc="state.data.gender"/>
                                            <span class="l">მომართვის წყარო</span><span class="v" t-esc="state.data.referralSource"/>
                                            <span class="l last">მეურვე / მშობელი</span><span class="v last" t-esc="state.data.guardian"/>
                                        </div>
                                    </div>
                                    <div class="cpc_card">
                                        <div class="cpc_card_t">სტატუსი</div>
                                        <div style="display:flex;flex-direction:column;gap:10px">
                                            <label t-attf-class="cpc_check {{ state.mainFlags.foreign ? 'on' : '' }}" t-on-click="() => this.toggleMain('foreign')"><t t-call="clinic_patient_card.checkbox"><t t-set="on" t-value="state.mainFlags.foreign"/></t><span class="lbl">უცხოელი პაციენტი</span></label>
                                            <label t-attf-class="cpc_check {{ state.mainFlags.first ? 'on' : '' }}" t-on-click="() => this.toggleMain('first')"><t t-call="clinic_patient_card.checkbox"><t t-set="on" t-value="state.mainFlags.first"/></t><span class="lbl">პირველადი ვიზიტი</span></label>
                                            <label t-attf-class="cpc_check {{ state.mainFlags.repeat ? 'on' : '' }}" t-on-click="() => this.toggleMain('repeat')"><t t-call="clinic_patient_card.checkbox"><t t-set="on" t-value="state.mainFlags.repeat"/></t><span class="lbl">განმეორებითი პაციენტი</span></label>
                                            <label t-attf-class="cpc_check {{ state.mainFlags.permanent ? 'on' : '' }}" t-on-click="() => this.toggleMain('permanent')"><t t-call="clinic_patient_card.checkbox"><t t-set="on" t-value="state.mainFlags.permanent"/></t><span class="lbl">მუდმივი პაციენტი</span></label>
                                            <label t-attf-class="cpc_check {{ state.mainFlags.minor ? 'on' : '' }}" t-on-click="() => this.toggleMain('minor')"><t t-call="clinic_patient_card.checkbox"><t t-set="on" t-value="state.mainFlags.minor"/></t><span class="lbl">არასრულწლოვანი</span></label>
                                        </div>
                                    </div>
                                </div>

                                <div class="cpc_card">
                                    <div class="cpc_card_head">
                                        <div class="cpc_card_t">საკონტაქტო ინფორმაცია</div>
                                        <button class="cpc_add">+ დამატება</button>
                                    </div>
                                    <div class="cpc_contacts">
                                        <div class="cpc_ctable">
                                            <div class="cpc_ch">ძირით.</div><div class="cpc_ch">ტელეფონი</div><div class="cpc_ch">კოდი</div>
                                            <div class="cpc_ch">ტიპი</div><div class="cpc_ch">არხი</div><div class="cpc_ch">საგანგებო</div>
                                            <div class="cpc_ch">ნათესაობა</div><div/>
                                            <t t-foreach="state.data.contacts" t-as="c" t-key="c.id">
                                                <div t-attf-class="cpc_cc {{ c.isPrimary ? 'tint first' : '' }}" style="display:flex;align-items:center">
                                                    <span t-attf-class="cpc_mark {{ c.isPrimary ? 'on' : 'off' }}"><t t-if="c.isPrimary"><t t-call="clinic_patient_card.ic_check"/></t></span>
                                                </div>
                                                <div t-attf-class="cpc_cc {{ c.isPrimary ? 'tint' : '' }}" style="font-weight:700" t-esc="c.phone"/>
                                                <div t-attf-class="cpc_cc {{ c.isPrimary ? 'tint' : '' }}" t-esc="c.countryCode"/>
                                                <div t-attf-class="cpc_cc {{ c.isPrimary ? 'tint' : '' }}" t-esc="c.type"/>
                                                <div t-attf-class="cpc_cc {{ c.isPrimary ? 'tint' : '' }}" t-esc="c.channel"/>
                                                <div t-attf-class="cpc_cc {{ c.isPrimary ? 'tint' : '' }}">
                                                    <span t-if="c.isEmergency" class="cpc_mark pink"><t t-call="clinic_patient_card.ic_check"/></span>
                                                    <span t-else="" style="color:var(--text-muted)">—</span>
                                                </div>
                                                <div t-attf-class="cpc_cc {{ c.isPrimary ? 'tint' : '' }}" t-esc="c.relation"/>
                                                <div t-attf-class="cpc_cc {{ c.isPrimary ? 'tint lastcol' : '' }}" style="display:flex;align-items:center">
                                                    <button class="cpc_x" t-on-click="() => this.removeContact(c.id)"><t t-call="clinic_patient_card.ic_x"/></button>
                                                </div>
                                            </t>
                                        </div>
                                    </div>
                                </div>

                                <div class="cpc_card">
                                    <div class="cpc_card_t">შენიშვნა</div>
                                    <textarea class="cpc_note" placeholder="შიდა შენიშვნა პაციენტზე…"
                                              t-att-value="state.note" t-on-input="(ev) => this.onNote(ev)"/>
                                </div>
                            </div>
                        </t>

                        <!-- ═══ TAB med ═══ -->
                        <t t-if="state.tab === 'med'">
                            <div class="cpc_col">
                                <div class="cpc_g4">
                                    <label t-attf-class="cpc_toggle {{ state.medFlags.smoker ? 'on' : '' }}" t-on-click="() => this.toggleMed('smoker')"><t t-call="clinic_patient_card.checkbox"><t t-set="on" t-value="state.medFlags.smoker"/></t><span class="t">მწეველი</span></label>
                                    <label t-attf-class="cpc_toggle {{ state.medFlags.alcohol ? 'on' : '' }}" t-on-click="() => this.toggleMed('alcohol')"><t t-call="clinic_patient_card.checkbox"><t t-set="on" t-value="state.medFlags.alcohol"/></t><span class="t">ალკოჰოლი</span></label>
                                    <label t-attf-class="cpc_toggle {{ state.medFlags.blood ? 'on' : '' }}" t-on-click="() => this.toggleMed('blood')"><t t-call="clinic_patient_card.checkbox"><t t-set="on" t-value="state.medFlags.blood"/></t><span class="t">სისხლის შედედება</span></label>
                                    <label t-attf-class="cpc_toggle {{ state.medFlags.cardio ? 'on' : '' }}" t-on-click="() => this.toggleMed('cardio')"><t t-call="clinic_patient_card.checkbox"><t t-set="on" t-value="state.medFlags.cardio"/></t><span class="t">კარდიო რისკი</span></label>
                                </div>

                                <div class="cpc_g128">
                                    <div class="cpc_card">
                                        <div class="cpc_card_t">ალერგიები და ანამნეზი</div>
                                        <div t-if="state.data.hasAllergy" class="cpc_allergy">
                                            <span class="cpc_bang">!</span>
                                            <div style="font-size:13px">
                                                <b t-esc="state.data.allergyTitle"/> · რეაქცია: <t t-esc="state.data.allergyReaction"/> · სიმძიმე: <t t-esc="state.data.allergySeverity"/>
                                                <div t-if="state.data.allergyNote" class="cpc_allergy_sub" t-esc="state.data.allergyNote"/>
                                            </div>
                                        </div>
                                        <div class="cpc_lv">
                                            <span class="l">ქრონიკული დაავადებები</span><span class="v" t-esc="state.data.chronicDiseases"/>
                                            <span class="l">მიმდ. მედიკამენტები</span><span class="v" t-esc="state.data.medications"/>
                                            <span class="l last">ოჯახური ანამნეზი</span><span t-attf-class="v last {{ state.data.familyHistory === '—' ? 'muted' : '' }}" t-esc="state.data.familyHistory"/>
                                        </div>
                                    </div>
                                    <div style="display:flex;flex-direction:column;gap:16px">
                                        <div class="cpc_dental">
                                            <div style="font-size:14px;font-weight:800;margin-bottom:12px">სტომატოლოგია</div>
                                            <div style="display:flex;flex-direction:column;gap:8px">
                                                <div class="row"><span class="k">ბოლო ვიზიტი</span><b t-esc="state.data.lastVisit"/></div>
                                                <div class="row"><span class="k">ბრუქსიზმი</span><b t-esc="state.data.bruxism"/></div>
                                                <div class="row"><span class="k">პაროდონტიტის რისკი</span><span class="cpc_pill_pink" t-esc="state.data.periodontitisRisk"/></div>
                                                <div class="row"><span class="k">განახლდა</span><b t-esc="state.data.updatedAt"/></div>
                                            </div>
                                        </div>
                                        <div class="cpc_card" style="padding:22px 24px">
                                            <div class="cpc_card_t">გამოსახულება</div>
                                            <div style="display:flex;gap:10px;flex-wrap:wrap">
                                                <span t-attf-class="cpc_imgchip {{ state.data.hasXray ? 'on' : '' }}"><t t-if="state.data.hasXray">✓ </t>რენტგენი</span>
                                                <span t-attf-class="cpc_imgchip {{ state.data.hasCt ? 'on' : '' }}"><t t-if="state.data.hasCt">✓ </t>კტ</span>
                                                <span class="cpc_imgchip">აქ გადაღებული</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- FDI chart -->
                                <div class="cpc_card" style="padding:26px 28px">
                                    <div style="display:flex;align-items:baseline;gap:14px;flex-wrap:wrap;margin-bottom:16px">
                                        <div class="cpc_card_t" style="margin:0">კბილის სქემა (FDI)</div>
                                        <span style="font-size:12px;color:var(--text-muted)">აირჩიეთ სტატუსი და დააწკაპუნეთ კბილზე</span>
                                    </div>
                                    <div class="cpc_legend">
                                        <t t-foreach="STATUSES" t-as="s" t-key="s.id">
                                            <button t-attf-class="cpc_lchip {{ state.brush === s.id ? 'on' : '' }}" t-on-click="() => this.setBrush(s.id)">
                                                <span class="cpc_sw" t-attf-style="{{ this.swatchStyle(s.id) }}"/>
                                                <t t-esc="s.label"/>
                                            </button>
                                        </t>
                                    </div>
                                    <div class="cpc_teeth">
                                        <div class="cpc_trow">
                                            <span class="cpc_tlbl">ზედა</span>
                                            <div class="cpc_tgroup">
                                                <t t-foreach="FDI.q1" t-as="n" t-key="n"><button t-attf-class="cpc_tooth {{ state.teeth[n] and state.teeth[n].status !== 'healthy' ? 'marked' : '' }}" t-attf-style="{{ this.toothStyle(n) }}" t-att-title="this.toothTitle(n)" t-on-click="() => this.paintTooth(n)" t-esc="n"/></t>
                                            </div>
                                            <div class="cpc_tgroup">
                                                <t t-foreach="FDI.q2" t-as="n" t-key="n"><button t-attf-class="cpc_tooth {{ state.teeth[n] and state.teeth[n].status !== 'healthy' ? 'marked' : '' }}" t-attf-style="{{ this.toothStyle(n) }}" t-att-title="this.toothTitle(n)" t-on-click="() => this.paintTooth(n)" t-esc="n"/></t>
                                            </div>
                                        </div>
                                        <div class="cpc_trow">
                                            <span class="cpc_tlbl">ქვედა</span>
                                            <div class="cpc_tgroup">
                                                <t t-foreach="FDI.q4" t-as="n" t-key="n"><button t-attf-class="cpc_tooth {{ state.teeth[n] and state.teeth[n].status !== 'healthy' ? 'marked' : '' }}" t-attf-style="{{ this.toothStyle(n) }}" t-att-title="this.toothTitle(n)" t-on-click="() => this.paintTooth(n)" t-esc="n"/></t>
                                            </div>
                                            <div class="cpc_tgroup">
                                                <t t-foreach="FDI.q3" t-as="n" t-key="n"><button t-attf-class="cpc_tooth {{ state.teeth[n] and state.teeth[n].status !== 'healthy' ? 'marked' : '' }}" t-attf-style="{{ this.toothStyle(n) }}" t-att-title="this.toothTitle(n)" t-on-click="() => this.paintTooth(n)" t-esc="n"/></t>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="cpc_tlist">
                                        <t t-if="!selectedTeeth.length">
                                            <div class="cpc_empty">მონიშნული კბილი ჯერ არ არის — აირჩიეთ სტატუსი და დააჭირეთ კბილს.</div>
                                        </t>
                                        <t t-foreach="selectedTeeth" t-as="r" t-key="r.num">
                                            <div class="cpc_trow_item">
                                                <span class="num" t-esc="r.num"/>
                                                <span class="cpc_sw" style="width:12px;height:12px" t-attf-style="{{ this.swatchStyle(r.status) }}"/>
                                                <span style="font-weight:600" t-esc="r.st.label"/>
                                                <span style="color:var(--text-muted)" t-esc="r.note || '—'"/>
                                                <button class="cpc_x" style="margin-left:auto" t-on-click="() => this.removeTooth(r.num)"><t t-call="clinic_patient_card.ic_x"/></button>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </t>

                        <!-- ═══ TAB fin ═══ -->
                        <t t-if="state.tab === 'fin'">
                            <div class="cpc_col">
                                <div class="cpc_g3">
                                    <div class="cpc_stat primary"><div class="l">დავალიანება</div><div class="v" t-esc="state.data.debt"/></div>
                                    <div class="cpc_stat pink"><div class="l">ავანსი</div><div class="v" t-esc="state.data.advance"/></div>
                                    <div class="cpc_stat"><div class="l">სულ ინვოისები</div><div class="v" t-esc="state.data.totalInvoiced"/></div>
                                </div>
                                <div class="cpc_g2">
                                    <div class="cpc_card">
                                        <div class="cpc_card_t">გადახდა და ლოიალობა</div>
                                        <div class="cpc_lv">
                                            <span class="l">გადახდის პირობები</span><span t-attf-class="v {{ state.data.paymentTerms === '—' ? 'muted' : '' }}" t-esc="state.data.paymentTerms"/>
                                            <span class="l">სასურველი მეთოდი</span><span t-attf-class="v {{ state.data.preferredMethod === '—' ? 'muted' : '' }}" t-esc="state.data.preferredMethod"/>
                                            <span class="l">ფასდაკლება (%)</span><span class="v" t-esc="state.data.discountPercent"/>
                                            <span class="l">ფასდაკლება (თანხა)</span><span class="v" t-esc="state.data.discountAmount"/>
                                            <span class="l last">ლოიალობის სტატუსი</span><span class="v last muted" t-esc="state.data.loyalty"/>
                                        </div>
                                    </div>
                                    <div class="cpc_card">
                                        <div class="cpc_card_t">დაზღვევა</div>
                                        <div class="cpc_lv">
                                            <span class="l">კომპანია</span><span t-attf-class="v {{ state.data.insuranceCompany === '—' ? 'muted' : '' }}" t-esc="state.data.insuranceCompany"/>
                                            <span class="l">პოლისის ნომერი</span><span class="v" t-esc="state.data.policyNo"/>
                                            <span class="l">ვადა</span><span class="v" t-esc="state.data.insuranceValidUntil"/>
                                            <span class="l last">შენიშვნები</span><span class="v last" t-esc="state.data.insuranceNotes"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="cpc_card">
                                    <div class="cpc_card_t">ინვოისები და გადახდები</div>
                                    <div class="cpc_empty" style="padding:32px">ინვოისები ჯერ არ არის — პირველი ინვოისი შეიქმნება ვიზიტის დასრულებისას</div>
                                </div>
                            </div>
                        </t>

                        <!-- ═══ TAB hist ═══ -->
                        <t t-if="state.tab === 'hist'">
                            <div class="cpc_col">
                                <div class="cpc_card">
                                    <div class="cpc_card_head">
                                        <div class="cpc_card_t">პროცედურები</div>
                                        <button class="cpc_add">+ დამატება</button>
                                    </div>
                                    <div style="display:flex;flex-direction:column;gap:8px">
                                        <t t-if="!state.data.procedures.length"><div class="cpc_empty">პროცედურა ჯერ არ არის.</div></t>
                                        <t t-foreach="state.data.procedures" t-as="p" t-key="p.id">
                                            <div class="cpc_prow">
                                                <span class="cpc_badge" t-esc="p.status"/>
                                                <span style="color:var(--text-muted)">პროცედურა: <t t-esc="p.name"/></span>
                                                <span>რაოდ. <b t-esc="p.qty"/></span>
                                                <span>თარიღი <b t-esc="p.date"/></span>
                                                <span>შემსრ. <b t-esc="p.performer"/></span>
                                                <span class="cpc_toothchip">კბილი <t t-esc="p.tooth"/></span>
                                                <button class="cpc_x" t-on-click="() => this.removeProcedure(p.id)"><t t-call="clinic_patient_card.ic_x"/></button>
                                            </div>
                                        </t>
                                    </div>
                                </div>

                                <div class="cpc_g128">
                                    <div class="cpc_card">
                                        <div class="cpc_card_head">
                                            <div class="cpc_card_t">დოკუმენტები</div>
                                            <button class="cpc_add">+ დამატება</button>
                                        </div>
                                        <div style="display:flex;flex-direction:column;gap:8px">
                                            <t t-if="!state.data.documents.length"><div class="cpc_empty">დოკუმენტი ჯერ არ არის.</div></t>
                                            <t t-foreach="state.data.documents" t-as="d" t-key="d.id">
                                                <div class="cpc_drow">
                                                    <span class="cpc_dico"><t t-call="clinic_patient_card.ic_filetext"/></span>
                                                    <div><b t-esc="d.title"/><div style="color:var(--text-muted);font-size:12px"><t t-esc="d.date"/> · <t t-esc="d.note"/></div></div>
                                                    <a href="#" style="margin-left:auto;font-size:12px;font-weight:700">ნახვა</a>
                                                </div>
                                            </t>
                                        </div>
                                    </div>
                                    <div class="cpc_card">
                                        <div class="cpc_card_t">პაციენტის პროფილი</div>
                                        <div style="display:flex;flex-direction:column;gap:12px;font-size:13px">
                                            <div>
                                                <div class="cpc_prow_between" style="margin-bottom:5px"><span style="color:var(--text-muted)">გაცდენების %</span><b t-esc="state.data.noShowRate.toFixed(2)"/></div>
                                                <div class="cpc_progress"><div t-attf-style="{{ this.barStyle(state.data.noShowRate, 'var(--primary)') }}"/></div>
                                            </div>
                                            <div>
                                                <div class="cpc_prow_between" style="margin-bottom:5px"><span style="color:var(--text-muted)">LTV პროგნოზი</span><b t-esc="state.data.ltvForecast.toFixed(2)"/></div>
                                                <div class="cpc_progress"><div t-attf-style="{{ this.barStyle(state.data.ltvForecast, 'var(--pink)') }}"/></div>
                                            </div>
                                            <div class="cpc_prow_between"><span style="color:var(--text-muted)">რისკის დონე</span><span style="color:var(--text-muted)" t-esc="state.data.riskLevel"/></div>
                                            <div class="cpc_prow_between"><span style="color:var(--text-muted)">რისკის დეტალები</span><span style="color:var(--text-muted)" t-esc="state.data.riskNotes"/></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </t>
                </div>
            </div>
        </div>
    </t>

</templates>
