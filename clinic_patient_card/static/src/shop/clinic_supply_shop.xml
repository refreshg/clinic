<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- one product card (used by the grid and the strips) -->
    <t t-name="clinic_patient_card.CsCard">
        <div class="cs_card">
            <span t-if="o.sponsored" class="cs_badge cs_badge_sp">დასპონსორებული</span>
            <span t-elif="o.is_new" class="cs_badge cs_badge_new">სიახლე</span>
            <span t-if="o.preorder and o.qty &lt;= 0" class="cs_badge cs_badge_pre">Pre-order</span>
            <button class="cs_wish" t-att-class="{ cs_wish_on: inWishlist(o) }"
                    t-on-click.stop="() => this.toggleWish(o)"
                    title="Wishlist">♥</button>
            <button class="cs_cmp_toggle" t-att-class="{ cs_cmp_on: inCompare(o) }"
                    t-on-click.stop="() => this.toggleCompare(o)"
                    title="შედარებაში დამატება">⇄</button>
            <div class="cs_card_img cs_clickable" t-on-click="() => this.openDetail(o)">
                <img t-if="o.image" t-att-src="'data:image/png;base64,' + o.image" alt=""/>
                <span t-else="" class="cs_noimg">🦷</span>
            </div>
            <div class="cs_card_name cs_clickable" t-on-click="() => this.openDetail(o)" t-esc="o.name"/>
            <div class="cs_card_vendor">
                <t t-esc="o.vendor_name"/>
                <span t-if="o.vendor_rating" class="cs_vrating">★ <t t-esc="o.vendor_rating"/></span>
            </div>
            <div class="cs_card_brand" t-esc="o.brand || ' '"/>
            <div class="cs_price"><t t-esc="o.price.toFixed(2)"/> ₾</div>
            <button class="btn btn-primary btn-sm w-100 mt-2"
                    t-on-click="() => this.addToCart(o)">კალათაში</button>
        </div>
    </t>

    <t t-name="clinic_patient_card.ClinicSupplyShop">
        <div class="clinic_shop">
            <div class="cs_top d-flex align-items-center flex-wrap gap-2 mb-3">
                <div class="me-auto">
                    <h4 class="mb-0 fw-bold">Supply Shop</h4>
                    <small class="text-muted">Browse products published by suppliers, fill the cart and send.</small>
                </div>
                <input type="text" class="form-control cs_search" placeholder="ძიება..."
                       t-att-value="state.search" t-on-input="(ev) => this.onSearch(ev)"/>
                <button class="btn" t-att-class="state.wishlistOnly ? 'btn-danger' : 'btn-outline-danger'"
                        t-on-click="() => this.toggleWishlistOnly()">
                    ♥ (<t t-esc="state.wishlist.length"/>)
                </button>
                <button t-if="state.lastOrder" class="btn btn-outline-primary"
                        t-on-click="() => this.repeatLastOrder()"
                        t-att-title="'გაიმეორე: ' + state.lastOrder.name">
                    🔁 ბოლო შეკვეთა
                </button>
                <button t-if="state.compareKeys.length" class="btn btn-outline-info"
                        t-on-click="() => this.openCompare()">
                    ⇄ შედარება (<t t-esc="state.compareKeys.length"/>)
                </button>
                <button class="btn btn-primary" t-on-click="() => this.toggleCart()">
                    🛒 კალათა (<t t-esc="cartCount"/>)
                </button>
            </div>

            <!-- banner slots: two per row (reviewer reference layout);
                 a banner with a link opens it in a new tab -->
            <div t-if="state.banners.length and isPlainView" class="cs_banner_wrap mb-3">
              <div class="cs_banner_grid">
                <t t-foreach="visibleBanners" t-as="bn" t-key="bn.id">
                    <div class="cs_banner" t-att-class="{ cs_banner_link: bn.link }"
                         t-att-title="bn.link || ''"
                         t-on-click="() => this.openBanner(bn)">
                        <img t-att-src="'data:image/png;base64,' + bn.image" alt=""/>
                        <div t-if="bn.show_text" class="cs_banner_txt">
                            <div class="cs_banner_title" t-esc="bn.name"/>
                            <div t-if="bn.note" class="cs_banner_note" t-esc="bn.note"/>
                        </div>
                    </div>
                </t>
              </div>
              <t t-if="state.banners.length > 2">
                  <button class="cs_banner_nav cs_banner_prev" t-on-click="() => this.nextBanner(-1)">‹</button>
                  <button class="cs_banner_nav cs_banner_next" t-on-click="() => this.nextBanner(1)">›</button>
              </t>
            </div>

            <!-- category tiles with photos + subcategory chips -->
            <div class="cs_tiles mb-2">
                <t t-foreach="topCategories" t-as="c" t-key="c.id">
                    <div class="cs_tile" t-att-class="{ cs_tile_on: state.catId === c.id }"
                         t-on-click="() => this.pickCat(c.id)">
                        <div class="cs_tile_img">
                            <img t-if="c.image" t-att-src="'data:image/png;base64,' + c.image" alt=""/>
                            <span t-else="">🗂️</span>
                        </div>
                        <div class="cs_tile_name" t-esc="c.name"/>
                    </div>
                </t>
            </div>
            <t t-foreach="chipRows" t-as="row" t-key="row.parent">
                <div class="cs_subcats mb-2" t-att-style="row_index ? 'margin-left:' + (row_index * 22) + 'px' : ''">
                    <span class="cs_subcats_label">
                        <t t-if="!row_index">📂 ქვეკატეგორიები:</t>
                        <t t-else="">↳</t>
                    </span>
                    <button type="button" class="btn btn-sm rounded-pill cs_subbtn"
                            t-att-class="{ cs_subbtn_on: !row.selectedId }"
                            t-on-click="() => this.pickSubcat(false, row.parent)">ყველა</button>
                    <t t-foreach="row.kids" t-as="sc" t-key="sc.id">
                        <button type="button" class="btn btn-sm rounded-pill cs_subbtn"
                                t-att-class="{ cs_subbtn_on: row.selectedId === sc.id }"
                                t-on-click="() => this.pickSubcat(sc.id, row.parent)" t-esc="sc.name"/>
                    </t>
                </div>
            </t>

            <div class="cs_subbar d-flex align-items-center mb-2">
                <div class="text-muted small">ნაპოვნია <t t-esc="shownOffers.length"/></div>
                <select class="form-select form-select-sm cs_sort ms-auto" t-on-change="(ev) => this.onSort(ev)">
                    <option value="name">სორტირება: სახელით</option>
                    <option value="price_asc">ფასი: ზრდადი</option>
                    <option value="price_desc">ფასი: კლებადი</option>
                </select>
            </div>

            <div class="cs_layout d-flex gap-3">
                <!-- filters -->
                <div class="cs_side">
                    <div class="fw-semibold mb-1">მომწოდებლები</div>
                    <t t-foreach="vendors" t-as="v" t-key="v.id">
                        <label class="cs_vrow">
                            <input type="checkbox" t-att-checked="!state.vendorOff[v.id]"
                                   t-on-change="() => this.toggleVendor(v.id)"/>
                            <span t-esc="v.name"/>
                        </label>
                    </t>
                    <div t-if="brands.length" class="fw-semibold mb-1 mt-3">ბრენდები</div>
                    <t t-foreach="brands" t-as="b" t-key="b.id">
                        <label class="cs_vrow">
                            <input type="checkbox" t-att-checked="!state.brandOff[b.id]"
                                   t-on-change="() => this.toggleBrand(b.id)"/>
                            <span t-esc="b.name"/>
                        </label>
                    </t>
                </div>

                <!-- main -->
                <div class="cs_main flex-grow-1">
                    <!-- front-page strips -->
                    <t t-if="isPlainView">
                        <t t-if="sponsoredOffers.length">
                            <div class="cs_strip_title">⭐ დასპონსორებული</div>
                            <div class="cs_strip">
                                <t t-foreach="sponsoredOffers" t-as="o" t-key="'sp_' + o.key">
                                    <t t-call="clinic_patient_card.CsCard"/>
                                </t>
                            </div>
                        </t>
                        <t t-if="newOffers.length">
                            <div class="cs_strip_title">🆕 სიახლეები</div>
                            <div class="cs_strip">
                                <t t-foreach="newOffers" t-as="o" t-key="'nw_' + o.key">
                                    <t t-call="clinic_patient_card.CsCard"/>
                                </t>
                            </div>
                        </t>
                        <t t-if="bestsellerOffers.length">
                            <div class="cs_strip_title">🔥 ბესთსელერები</div>
                            <div class="cs_strip">
                                <t t-foreach="bestsellerOffers" t-as="o" t-key="'bs_' + o.key">
                                    <t t-call="clinic_patient_card.CsCard"/>
                                </t>
                            </div>
                        </t>
                        <div class="cs_strip_title">ყველა პროდუქტი</div>
                    </t>

                    <div t-if="!shownOffers.length" class="text-muted p-5 text-center">
                        პროდუქტები ვერ მოიძებნა.
                    </div>
                    <div t-else="" class="cs_grid">
                        <t t-foreach="shownOffers" t-as="o" t-key="o.key">
                            <t t-call="clinic_patient_card.CsCard"/>
                        </t>
                    </div>

                    <!-- similar products while searching -->
                    <t t-if="similarOffers.length">
                        <div class="cs_strip_title mt-3">🔎 მსგავსი პროდუქტები</div>
                        <div class="cs_strip">
                            <t t-foreach="similarOffers" t-as="o" t-key="'sim_' + o.key">
                                <t t-call="clinic_patient_card.CsCard"/>
                            </t>
                        </div>
                    </t>
                </div>

                <!-- cart panel -->
                <div t-if="state.cartOpen" class="cs_cart">
                    <div class="d-flex align-items-center mb-2">
                        <div class="fw-bold flex-grow-1">კალათა</div>
                        <button class="btn btn-sm btn-light" t-on-click="() => this.toggleCart()">✕</button>
                    </div>
                    <div t-if="!cartLines.length" class="text-muted small">კალათა ცარიელია.</div>
                    <t t-foreach="cartLines" t-as="l" t-key="l.key">
                        <div class="cs_cart_line">
                            <div class="flex-grow-1">
                                <div class="fw-semibold" t-esc="l.name"/>
                                <div class="text-muted small" t-esc="l.vendor_name"/>
                            </div>
                            <input type="number" min="1" class="form-control form-control-sm cs_qty"
                                   t-att-value="l.qty" t-on-change="(ev) => this.setQty(l.key, ev)"/>
                            <div class="cs_line_sub" t-esc="(l.price * l.qty).toFixed(2)"/>
                            <button class="btn btn-sm btn-link text-danger" t-on-click="() => this.removeLine(l.key)">✕</button>
                        </div>
                    </t>
                    <div class="d-flex align-items-center mt-2 pt-2 border-top">
                        <div class="fw-bold flex-grow-1">სულ</div>
                        <div class="fw-bold" t-esc="cartTotal.toFixed(2)"/>
                    </div>
                    <button class="btn btn-primary w-100 mt-2" t-att-disabled="!cartLines.length"
                            t-on-click="() => this.checkout()">გაეგზავნოს მომწოდებლებს</button>
                </div>
            </div>

            <!-- compare modal -->
            <div t-if="state.compareOpen" class="cs_modal_backdrop" t-on-click="() => state.compareOpen = false">
                <div class="cs_modal cs_cmp_modal" t-on-click.stop="() => {}">
                    <button class="cs_modal_close" t-on-click="() => state.compareOpen = false">✕</button>
                    <h5 class="fw-bold mb-3">⇄ პროდუქტების შედარება</h5>
                    <div class="table-responsive">
                        <table class="table table-bordered cs_cmp_table">
                            <tbody>
                                <tr>
                                    <th/>
                                    <td t-foreach="compareOffers" t-as="o" t-key="o.key" class="text-center">
                                        <img t-if="o.image" t-att-src="'data:image/png;base64,' + o.image" alt=""/>
                                        <span t-else="" class="cs_noimg">🦷</span>
                                        <div class="fw-bold mt-1" t-esc="o.name"/>
                                        <a href="#" class="small text-danger"
                                           t-on-click.prevent="() => this.toggleCompare(o)">ამოღება ✕</a>
                                    </td>
                                </tr>
                                <tr><th>ფასი</th><td t-foreach="compareOffers" t-as="o" t-key="o.key" class="text-center fw-bold"><t t-esc="o.price.toFixed(2)"/> ₾</td></tr>
                                <tr><th>მომწოდებელი</th><td t-foreach="compareOffers" t-as="o" t-key="o.key" class="text-center"><t t-esc="o.vendor_name"/><span t-if="o.vendor_rating" class="cs_vrating"> ★ <t t-esc="o.vendor_rating"/></span></td></tr>
                                <tr><th>მიწოდების ვადა</th><td t-foreach="compareOffers" t-as="o" t-key="o.key" class="text-center"><t t-esc="o.delay"/> დღე</td></tr>
                                <tr><th>ბრენდი</th><td t-foreach="compareOffers" t-as="o" t-key="o.key" class="text-center"><t t-esc="o.brand || '—'"/></td></tr>
                                <tr><th>კატეგორია</th><td t-foreach="compareOffers" t-as="o" t-key="o.key" class="text-center"><t t-esc="o.categ_name || '—'"/></td></tr>
                                <tr><th>მარაგი</th><td t-foreach="compareOffers" t-as="o" t-key="o.key" class="text-center"><t t-esc="o.qty"/><span t-if="o.preorder and o.qty &lt;= 0"> · Pre-order</span></td></tr>
                                <tr><th/>
                                    <td t-foreach="compareOffers" t-as="o" t-key="o.key" class="text-center">
                                        <button class="btn btn-primary btn-sm" t-on-click="() => this.addToCart(o)">კალათაში</button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="text-end">
                        <button class="btn btn-light btn-sm" t-on-click="() => this.clearCompare()">გასუფთავება</button>
                    </div>
                </div>
            </div>

            <!-- product detail modal -->
            <div t-if="state.detail" class="cs_modal_backdrop" t-on-click="() => this.closeDetail()">
                <div class="cs_modal" t-on-click.stop="() => {}">
                    <button class="cs_modal_close" t-on-click="() => this.closeDetail()">✕</button>
                    <div class="cs_modal_body">
                        <div class="cs_modal_img">
                            <img t-if="state.detail.image_big"
                                 t-att-src="'data:image/png;base64,' + state.detail.image_big" alt=""/>
                            <span t-else="" class="cs_noimg">🦷</span>
                        </div>
                        <div class="cs_modal_info">
                            <h3 t-esc="state.detail.name"/>
                            <div class="text-muted mb-1" t-esc="state.detail.vendor_name"/>
                            <div t-if="state.detail.brand" class="cs_card_brand mb-1" t-esc="state.detail.brand"/>
                            <div class="cs_modal_price"><t t-esc="state.detail.price.toFixed(2)"/> ₾</div>
                            <div t-if="state.detail.desc" class="cs_modal_desc" t-out="state.detail.desc"/>
                            <div class="cs_stock">
                                <t t-esc="state.detail.qty_available"/> მარაგში
                                <span t-if="state.detail.preorder and state.detail.qty_available &lt;= 0"
                                      class="cs_badge_pre_inline">Pre-order — შეკვეთა მაინც შესაძლებელია</span>
                            </div>
                            <div class="d-flex align-items-center gap-2 mt-3">
                                <input type="number" min="1" class="form-control cs_dqty"
                                       t-att-value="state.detail.addQty"
                                       t-on-change="(ev) => this.setDetailQty(ev)"/>
                                <button class="btn btn-primary" t-on-click="() => this.addDetailToCart()">კალათაში</button>
                            </div>
                            <div t-if="state.detail.delay" class="text-muted small mt-2">
                                მიწოდების ვადა: <t t-esc="state.detail.delay"/> დღე
                            </div>

                            <!-- vendor price comparison -->

                            <!-- similar products -->
                            <t t-if="state.detail.similar.length">
                                <div class="fw-semibold mt-3 mb-1">მსგავსი პროდუქტები</div>
                                <div class="cs_strip cs_strip_sm">
                                    <t t-foreach="state.detail.similar" t-as="o" t-key="'ds_' + o.key">
                                        <div class="cs_mini cs_clickable" t-on-click="() => this.openDetail(o)">
                                            <img t-if="o.image" t-att-src="'data:image/png;base64,' + o.image" alt=""/>
                                            <span t-else="" class="cs_noimg">🦷</span>
                                            <div class="cs_mini_name" t-esc="o.name"/>
                                            <div class="cs_mini_price"><t t-esc="o.price.toFixed(2)"/> ₾</div>
                                        </div>
                                    </t>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>

</templates>
