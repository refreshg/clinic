<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="clinic_patient_card.VisitPage">
    <div class="clinic_visit_page" t-if="state.data">
        <!-- ===== header info cards ===== -->
        <div class="cvp_head">
            <div class="cvp_card cvp_patient" t-on-click="openPatient">
                <div class="cvp_pname" t-esc="state.data.patient.name"/>
                <div class="cvp_meta">
                    <span t-if="state.data.patient.birthdate">📅 <t t-esc="state.data.patient.birthdate"/></span>
                    <span t-if="state.data.patient.vat">🪪 <t t-esc="state.data.patient.vat"/></span>
                    <span t-if="state.data.patient.phone" class="cvp_phone">📞 <t t-esc="state.data.patient.phone"/></span>
                </div>
            </div>
            <div class="cvp_card">
                <div class="cvp_ctitle">დაზღვევა</div>
                <div t-esc="state.data.patient.insurance || 'არ აქვს'"/>
            </div>
            <div class="cvp_card">
                <div class="cvp_ctitle">ვიზიტის თარიღი</div>
                <div t-esc="visitRange"/>
            </div>
            <div class="cvp_card" t-att-class="state.data.patient.allergies.length ? 'cvp_warn' : ''">
                <div class="cvp_ctitle">ალერგ. ცნობა</div>
                <div t-esc="state.data.patient.allergies.length ? state.data.patient.allergies.join(', ') : '—'"/>
            </div>
            <div class="cvp_card">
                <div class="cvp_ctitle">თანხმობა</div>
                <div t-esc="state.data.visit.consent_signed ? '✓ ხელმოწერილია' : '✗ არაა'"/>
            </div>
            <div class="cvp_card cvp_doc">
                <div class="cvp_ctitle">მკურნალი ექიმი</div>
                <div t-esc="state.data.visit.dentist"/>
                <div class="cvp_meta" t-if="state.data.visit.assistant">
                    რეზიდენტი: <t t-esc="state.data.visit.assistant"/>
                </div>
                <div class="cvp_meta" t-if="state.data.visit.curator">
                    კურატორი: <t t-esc="state.data.visit.curator"/>
                </div>
            </div>
        </div>

        <!-- ===== tabs ===== -->
        <div class="cvp_tabs">
            <button class="cvp_back" t-on-click="backToCalendar">← კალენდარი</button>
            <button class="cvp_visitform" t-on-click="openVisitForm"
                    t-if="!state.data.is_admin">✎ ვიზიტის ფორმა</button>
            <button class="cvp_patientbtn" t-on-click="openPatient">🧑 პაციენტის ანკეტა</button>
            <button t-att-class="state.tab === 'procedures' ? 'active' : ''"
                    t-on-click="() => state.tab = 'procedures'"
                    t-if="!state.data.is_admin">პროცედურები</button>
            <button t-att-class="state.tab === 'billing' ? 'active' : ''"
                    t-on-click="() => state.tab = 'billing'"
                    t-if="state.data.is_admin">ანგარიშსწორება</button>
            <!-- doctor-only placeholders (the administrator does not need them) -->
            <button class="disabled" title="მალე" t-if="!state.data.is_admin">გახარჯული მასალები</button>
            <button class="disabled" title="მალე" t-if="!state.data.is_admin">EHR სინქრონიზაცია</button>
        </div>

        <!-- ===== procedures tab ===== -->
        <!-- ===== health warning (red): on every tab, for doctor and admin alike ===== -->
        <div class="cvp_health"
             t-att-class="healthSevere ? 'cvp_health_hot' : ''">
            <span class="cvp_h_item" t-if="state.data.patient.health.pregnancy_applies">
                <t t-if="state.data.patient.health.pregnancy === 'yes'"><img class="cvp_h_ico" src="/clinic_patient_card/static/src/img/pregnant.svg" alt=""/> <b>ორსულია</b></t>
                <t t-elif="state.data.patient.health.pregnancy === 'no'"><b>ორსულობა:</b> არა</t>
                <t t-else=""><b>ორსულობა:</b> <span class="cvp_h_missing">შეუვსებელია!</span></t>
            </span>
            <span class="cvp_h_item">
                <t t-if="state.data.patient.health.allergy === 'yes'"><img class="cvp_h_ico" src="/clinic_patient_card/static/src/img/allergy.svg" alt=""/> <b>ალერგია:</b>
                    <t t-esc="state.data.patient.health.allergies.length ? state.data.patient.health.allergies.join(', ') : 'რაზე — არ არის მითითებული'"/>
                </t>
                <t t-elif="state.data.patient.health.allergy === 'no'"><b>ალერგია:</b> არა</t>
                <t t-else=""><b>ალერგია:</b> <span class="cvp_h_missing">შეუვსებელია!</span></t>
            </span>
        </div>

        <div class="cvp_body" t-if="state.tab === 'procedures' and !state.data.is_admin">
            <!-- left: medical sections -->
            <div class="cvp_side">
                <div class="cvp_sside_title">მკურნალობა</div>
                <button t-att-class="'cvp_sec ' + (state.section === null ? 'open' : '')"
                        t-on-click="() => state.section = null">
                    <span t-att-class="'cvp_dot ' + (state.data.procedures.length ? 'ok' : '')"/>
                    მკურნალობა (პროცედურები)
                </button>
                <t t-foreach="sectionsMeta" t-as="sec" t-key="sec.key">
                    <button t-att-class="'cvp_sec ' + (state.section === sec.key ? 'open' : '')"
                            t-on-click="() => this.openSection(sec.key)">
                        <span t-att-class="'cvp_dot ' + (sectionFilled(sec.key) ? 'ok' : '')"/>
                        <t t-esc="sec.label"/>
                    </button>
                </t>
            </div>

            <!-- center -->
            <div class="cvp_main">
                <!-- section editor: plain text -->
                <div t-if="state.section and sectionMeta(state.section).kind === 'text'"
                     class="cvp_secedit">
                    <textarea rows="10" t-model="state.sectionDraft"
                              placeholder="ჩაწერე ტექსტი…"/>
                    <button class="btn btn-primary w-100 mt-2"
                            t-on-click="saveSection">შენახვა</button>
                    <!-- examination results: files too (one or several), like the allergy test -->
                    <div class="cvp_algdocs mt-4" t-if="state.section === 'clinic_exam_results'">
                        <div class="cvp_ctitle">გამოკვლევის შედეგების ფაილები</div>
                        <label class="btn cvp_finishbtn cvp_upload">
                            📎 შედეგის ატვირთვა
                            <input type="file" multiple="multiple" class="d-none"
                                   t-on-change="uploadExamDocs"/>
                        </label>
                        <table class="cvp_table" t-if="(state.data.exam_docs || []).length">
                            <thead><tr>
                                <th>ფაილი</th><th>ატვირთვის დრო</th><th>ვინ ატვირთა</th><th/>
                            </tr></thead>
                            <tbody>
                                <tr t-foreach="state.data.exam_docs" t-as="dc" t-key="dc.id">
                                    <td><a t-att-href="'/web/content/clinic.patient.document/' + dc.id + '/attachment?download=true'"
                                           t-esc="dc.filename"/></td>
                                    <td t-esc="dc.uploaded_at"/>
                                    <td t-esc="dc.uploaded_by"/>
                                    <td><button class="cvp_del"
                                                t-on-click="() => this.removeExamDoc(dc)">🗑</button></td>
                                </tr>
                            </tbody>
                        </table>
                        <div t-else="" class="text-muted mt-2">ფაილი არ არის ატვირთული</div>
                    </div>
                </div>

                <div t-elif="state.section === 'complaints'" class="cvp_secedit">
                    <div class="cvp_field mb-2">
                        <label>შემთხვევის ტიპი</label>
                        <select t-model="state.compDraft.case_type">
                            <option value="planned">გეგმიური</option>
                            <option value="urgent">გადაუდებელი</option>
                        </select>
                    </div>
                    <div class="cvp_field mb-2">
                        <label>ჩივილები</label>
                        <!-- tick boxes (user 2026-10-08); a tick saves at once -->
                        <div class="cvp_complist">
                            <label t-foreach="state.data.complaint_catalog" t-as="c" t-key="c.id"
                                   t-att-class="'cvp_chk' + (isComplaint(c.id) ? ' on' : '')">
                                <input type="checkbox" t-att-checked="isComplaint(c.id)"
                                       t-on-change="() => this.toggleComplaint(c.id)"/>
                                <t t-esc="c.name"/>
                            </label>
                        </div>
                    </div>
                    <div class="cvp_field mb-2">
                        <label>დაავადებული კბილ(ებ)ი</label>
                        <input type="text" t-model="state.compDraft.teeth" placeholder="მაგ. 16, 26"/>
                    </div>
                    <div class="cvp_field mb-2">
                        <label>სხვა</label>
                        <input type="text" t-model="state.compDraft.other"/>
                    </div>
                    <div class="cvp_field mb-2">
                        <label>ანამნეზი</label>
                        <textarea rows="5" t-model="state.compDraft.anamnesis"/>
                    </div>
                    <button class="btn btn-primary w-100"
                            t-on-click="saveComplaints">შენახვა</button>
                </div>

                <div t-elif="state.section === 'objective'" class="cvp_secedit">
                    <!-- D-49: the checkbox groups of form IV-220-1/ა -->
                    <div class="cvp_checks mb-3">
                        <div class="cvp_checkgrp">
                            <div class="cvp_ctitle">პაროდონტის მდგომარეობა</div>
                            <label t-foreach="state.data.form_vocab.perio" t-as="o" t-key="o[0]" class="cvp_chk">
                                <input type="checkbox" t-att-checked="isChecked('perio', o[0])"
                                       t-on-change="() => this.toggleCheck('perio', o[0])"/>
                                <t t-esc="o[1]"/>
                            </label>
                        </div>
                        <div class="cvp_checkgrp">
                            <div class="cvp_ctitle">ნადები</div>
                            <label t-foreach="state.data.form_vocab.plaque" t-as="o" t-key="o[0]" class="cvp_chk">
                                <input type="checkbox" t-att-checked="isChecked('plaque', o[0])"
                                       t-on-change="() => this.toggleCheck('plaque', o[0])"/>
                                <t t-esc="o[1]"/>
                            </label>
                        </div>
                        <div class="cvp_checkgrp">
                            <div class="cvp_ctitle">გამოკვლევის გეგმა</div>
                            <label t-foreach="state.data.form_vocab.plan" t-as="o" t-key="o[0]" class="cvp_chk">
                                <input type="checkbox" t-att-checked="isChecked('plan', o[0])"
                                       t-on-change="() => this.toggleCheck('plan', o[0])"/>
                                <t t-esc="o[1]"/>
                            </label>
                        </div>
                    </div>
                    <div class="cvp_objgrid">
                        <t t-foreach="objFields" t-as="f" t-key="f[0]">
                            <div class="cvp_field mb-2">
                                <label t-esc="f[1]"/>
                                <input type="text"
                                       t-att-value="state.objDraft[f[0]]"
                                       t-on-input="(ev) => state.objDraft[f[0]] = ev.target.value"/>
                            </div>
                        </t>
                    </div>
                    <button class="btn btn-primary w-100"
                            t-on-click="saveObjective">შენახვა</button>
                </div>

                <div t-elif="state.section === 'prescription'" class="cvp_secedit">
                    <div class="cvp_pick">
                        <div class="cvp_field">
                            <label>ტიპი</label>
                            <select t-model="state.rxDraft.rec_type">
                                <t t-foreach="recTypes" t-as="rt" t-key="rt[0]">
                                    <option t-att-value="rt[0]" t-esc="rt[1]"/>
                                </t>
                            </select>
                        </div>
                        <div class="cvp_field">
                            <label>მედიკამენტი</label>
                            <input type="text" t-model="state.rxDraft.medicament"/>
                        </div>
                        <div class="cvp_field">
                            <label>მიღების პერიოდი</label>
                            <input type="text" t-model="state.rxDraft.period"
                                   placeholder="მაგ. 7 დღე, დღეში 2-ჯერ"/>
                        </div>
                        <div class="cvp_field cvp_toothsel">
                            <label>რაოდენობა</label>
                            <input type="number" min="0" t-model="state.rxDraft.qty"/>
                        </div>
                    </div>
                    <div class="cvp_field mb-2">
                        <label>მიღების წესი</label>
                        <textarea rows="3" t-model="state.rxDraft.directions"/>
                    </div>
                    <button class="btn btn-primary w-100"
                            t-on-click="addPrescription">＋ დამატება</button>
                    <table class="cvp_table" t-if="state.data.prescriptions.length">
                        <thead><tr>
                            <th>ტიპი</th><th>მედიკამენტი</th><th>პერიოდი</th>
                            <th>რაოდ.</th><th>მიღების წესი</th><th/>
                        </tr></thead>
                        <tbody>
                            <t t-foreach="state.data.prescriptions" t-as="rx" t-key="rx.id">
                                <tr>
                                    <td t-esc="recTypeLabel(rx.rec_type)"/>
                                    <td t-esc="rx.medicament"/>
                                    <td t-esc="rx.period"/>
                                    <td t-esc="rx.qty"/>
                                    <td t-esc="rx.directions"/>
                                    <td><button class="cvp_del"
                                                t-on-click="() => this.removePrescription(rx)">🗑</button></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                    <div t-else="" class="text-muted mt-3">ჩანაწერი არ მოიძებნა</div>
                    <!-- the sheet: print / PDF / e-mail to the patient -->
                    <div class="d-flex flex-wrap gap-2 mt-3 o_clinic_quick_btns" t-if="state.data.prescriptions.length">
                        <button type="button" class="btn btn-secondary" t-on-click="printRx">🖨 ბეჭდვა</button>
                        <button type="button" class="btn btn-secondary" t-on-click="pdfRx">⬇ PDF</button>
                        <button type="button" class="btn btn-secondary" t-on-click="mailRx">✉ მეილზე გაგზავნა</button>
                    </div>
                </div>

                <div t-elif="state.section === 'allergy'" class="cvp_secedit">
                    <div class="cvp_pick">
                        <div class="cvp_field">
                            <label>მედიკამენტი / ნივთიერება</label>
                            <input type="text" t-model="state.algDraft.name"/>
                        </div>
                        <div class="cvp_field">
                            <label>კომპონენტი / რეაქცია</label>
                            <input type="text" t-model="state.algDraft.reaction"/>
                        </div>
                        <div class="cvp_field">
                            <label>ექიმის მიერ დაზუსტება</label>
                            <input type="text" t-model="state.algDraft.note"/>
                        </div>
                    </div>
                    <button class="btn w-100 cvp_finishbtn"
                            t-on-click="addAllergy">დაამატეთ</button>
                    <table class="cvp_table" t-if="state.data.allergies.length">
                        <!-- the same columns as the patient card's allergy list -->
                        <thead><tr>
                            <th>ტიპი</th><th>ნივთიერება</th><th>რეაქცია</th>
                            <th>სიმძიმე</th><th>ალერგიული სინჯი</th><th>სინჯის შედეგი</th>
                            <th>შენიშვნა</th><th/>
                        </tr></thead>
                        <tbody>
                            <t t-foreach="state.data.allergies" t-as="al" t-key="al.id">
                                <tr>
                                    <td t-esc="al.type"/>
                                    <td class="fw-bold" t-esc="al.name"/>
                                    <td t-esc="al.reaction"/>
                                    <td t-esc="al.severity"/>
                                    <td t-esc="al.test_done ? '✓ ჩატარდა' : ''"/>
                                    <td t-esc="al.test_result"/>
                                    <td t-esc="al.note"/>
                                    <td><button class="cvp_del"
                                                t-on-click="() => this.removeAllergy(al)">🗑</button></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                    <div t-else="" class="text-muted mt-3">ჩანაწერი არ მოიძებნა</div>

                    <div class="cvp_algdocs mt-4">
                        <div class="cvp_ctitle">ალერგიის საბუთები</div>
                        <label class="btn cvp_finishbtn cvp_upload">
                            📎 საბუთის ატვირთვა
                            <input type="file" multiple="multiple" class="d-none"
                                   t-on-change="uploadAllergyDocs"/>
                        </label>
                        <table class="cvp_table" t-if="(state.data.allergy_docs || []).length">
                            <thead><tr>
                                <th>ფაილი</th><th>ატვირთვის დრო</th><th>ვინ ატვირთა</th><th/>
                            </tr></thead>
                            <tbody>
                                <tr t-foreach="state.data.allergy_docs" t-as="dc" t-key="dc.id">
                                    <td><a t-att-href="'/web/content/clinic.patient.document/' + dc.id + '/attachment?download=true'"
                                           t-esc="dc.filename"/></td>
                                    <td t-esc="dc.uploaded_at"/>
                                    <td t-esc="dc.uploaded_by"/>
                                    <td><button class="cvp_del"
                                                t-on-click="() => this.removeAllergyDoc(dc)">🗑</button></td>
                                </tr>
                            </tbody>
                        </table>
                        <div t-else="" class="text-muted mt-2">საბუთი არ არის ატვირთული</div>
                    </div>
                </div>

                <div t-else="">
                    <div class="cvp_odo_title">აირჩიეთ კბილი დიაგნოზის დასამატებლად</div>
                    <ClinicToothChart partnerId="state.data.patient.id" selected="state.tooth"
                                      version="state.chartVer" onSelect="(n) => this.pickTooth(n)"/>
                    <!-- milk teeth (51–85): only for a child under 14 -->
                    <div class="cvp_odo" t-if="state.data.patient.child">
                        <t t-foreach="fdiRows" t-as="row" t-key="row_index">
                            <div t-att-class="'cvp_row ' + row.cls">
                                <div class="cvp_half">
                                    <t t-foreach="row.left" t-as="n" t-key="n">
                                        <button t-att-class="'cvp_tooth ' + (isSel(n) ? 'sel' : '')"
                                                t-on-click="() => this.pickTooth(n)">
                                            <span class="cvp_ticon">🦷</span>
                                            <span t-esc="n"/>
                                        </button>
                                    </t>
                                </div>
                                <div class="cvp_half">
                                    <t t-foreach="row.right" t-as="n" t-key="n">
                                        <button t-att-class="'cvp_tooth ' + (isSel(n) ? 'sel' : '')"
                                                t-on-click="() => this.pickTooth(n)">
                                            <span class="cvp_ticon">🦷</span>
                                            <span t-esc="n"/>
                                        </button>
                                    </t>
                                </div>
                            </div>
                        </t>
                    </div>

                    <div class="cvp_pick">
                        <div class="cvp_field">
                            <label>ICD-10 დიაგნოზი</label>
                            <select t-model.number="state.icd10Id">
                                <option value="">აირჩიეთ ICD-10 დიაგნოზი</option>
                                <t t-foreach="state.data.icd10" t-as="d" t-key="d.id">
                                    <option t-att-value="d.id"><t t-esc="d.code"/> - <t t-esc="d.name"/></option>
                                </t>
                            </select>
                        </div>
                        <div class="cvp_field">
                            <label>პროცედურა</label>
                            <select t-model.number="state.productId">
                                <option value="">აირჩიეთ პროცედურა</option>
                                <t t-foreach="state.data.products" t-as="p" t-key="p.id">
                                    <option t-att-value="p.id"><t t-esc="p.name"/> — <t t-esc="p.lst_price"/>₾</option>
                                </t>
                            </select>
                        </div>
                        <div class="cvp_field cvp_toothsel">
                            <label>კბილი</label>
                            <span class="cvp_toothbadge" t-esc="state.tooth || '—'"/>
                        </div>
                    </div>
                    <button class="btn btn-primary w-100 cvp_add"
                            t-att-disabled="state.saving"
                            t-on-click="addProcedure">🦷 დამატება</button>

                    <!-- procedures table -->
                    <table class="cvp_table" t-if="state.data.procedures.length">
                        <thead><tr>
                            <th>კბილი #</th><th>პროცედურა და დიაგნოზი</th>
                            <th>ფასი</th><th>ფასდაკ. %</th><th>ჯამი</th>
                            <th>სტატუსი</th><th/>
                        </tr></thead>
                        <tbody>
                            <t t-foreach="state.data.procedures" t-as="pr" t-key="pr.id">
                                <tr>
                                    <td t-esc="pr.tooth || '—'"/>
                                    <td>
                                        <div t-esc="pr.procedure_id ? pr.procedure_id[1] : pr.name"/>
                                        <small class="text-muted" t-if="pr.icd10_id" t-esc="pr.icd10_id[1]"/>
                                    </td>
                                    <td t-esc="pr.price_unit"/>
                                    <td>
                                        <input type="number" min="0" max="100" class="cvp_disc"
                                               t-att-value="pr.discount_percent"
                                               t-on-change="(ev) => this.setProcDiscount(pr, ev.target.value)"/>
                                    </td>
                                    <td t-esc="pr.amount_total"/>
                                    <td>
                                        <select t-att-value="pr.status"
                                                t-on-change="(ev) => this.setProcStatus(pr, ev.target.value)">
                                            <t t-foreach="procStatuses" t-as="st" t-key="st[0]">
                                                <option t-att-value="st[0]"
                                                        t-att-selected="pr.status === st[0] ? 'selected' : undefined">
                                                    <t t-esc="st[1]"/>
                                                </option>
                                            </t>
                                        </select>
                                    </td>
                                    <td><button class="cvp_del" t-on-click="() => this.removeProc(pr)">🗑</button></td>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot><tr>
                            <td colspan="4" class="text-end fw-bold">ჯამური ფასი:</td>
                            <td class="fw-bold" t-esc="procTotal"/>
                            <td colspan="2"/>
                        </tr></tfoot>
                    </table>
                    <div t-else="" class="text-muted mt-3">ჩანაწერი არ მოიძებნა</div>
                </div>
            </div>
        </div>

        <!-- ===== billing tab (D4) ===== -->
        <div class="cvp_body cvp_billing" t-if="state.tab === 'billing' and state.data.is_admin">
            <div class="cvp_main">
                <h5>პროცედურების ანგარიშსწორება</h5>
                <div class="text-danger small mb-2">ფინანსური ინფორმაცია — ანგარიშსწორების შემდეგ რედაქტირება აღარ შეიძლება!</div>

                <!-- Procedure breakdown table -->
                <table class="cvp_bill_table" t-if="state.data.procedures.length">
                    <thead>
                        <tr>
                            <th>კბილი</th>
                            <th>პროცედურა</th>
                            <th class="text-center">რაოდ.</th>
                            <th class="text-end">ფასი</th>
                            <th class="text-end">ფასდაკ. %</th>
                            <th class="text-end">ჯამი</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="state.data.procedures" t-as="proc" t-key="proc.id">
                            <tr>
                                <td t-esc="proc.tooth || '—'"/>
                                <td t-esc="proc.procedure_id ? proc.procedure_id[1] : (proc.name || '—')"/>
                                <td class="text-center" t-esc="proc.qty || 1"/>
                                <td class="text-end" t-esc="(proc.price_unit || 0).toFixed(2)"/>
                                <td class="text-end" t-esc="proc.discount_percent ? proc.discount_percent + '%' : '—'"/>
                                <td class="text-end fw-bold" t-esc="(proc.amount_total || 0).toFixed(2)"/>
                            </tr>
                        </t>
                    </tbody>
                    <tfoot>
                        <tr t-foreach="state.data.retail || []" t-as="r" t-key="r.id">
                            <td colspan="2" class="text-end">რეალიზაცია</td>
                            <td colspan="3"><span t-esc="r.name"/> — <span class="text-muted" t-esc="r.lines"/></td>
                            <td class="text-end fw-bold" t-esc="(r.amount || 0).toFixed(2)"/>
                        </tr>
                        <tr>
                            <td colspan="5" class="text-end fw-bold">სულ:</td>
                            <td class="text-end fw-bold" t-esc="totalAmount.toFixed(2) + ' ₾'"/>
                        </tr>
                    </tfoot>
                </table>
                <div t-if="!state.data.procedures.length and !(state.data.retail || []).length" class="text-muted mb-3">
                    პროცედურები ჯერ არ არის დამატებული
                </div>
                <table t-if="!state.data.procedures.length and (state.data.retail || []).length" class="cvp_bill_table">
                    <tbody>
                        <tr t-foreach="state.data.retail" t-as="r" t-key="r.id">
                            <td>რეალიზაცია</td>
                            <td><span t-esc="r.name"/> — <span class="text-muted" t-esc="r.lines"/></td>
                            <td class="text-end fw-bold" t-esc="(r.amount || 0).toFixed(2) + ' ₾'"/>
                        </tr>
                    </tbody>
                </table>

                <div class="cvp_bill_cards mt-3">
                    <div class="cvp_card"><div class="cvp_ctitle">გადასახდელი</div>
                        <div class="cvp_amount" t-esc="totalAmount.toFixed(2) + ' ₾'"/></div>
                    <div class="cvp_card"><div class="cvp_ctitle">გადახდილი</div>
                        <div class="cvp_amount" t-esc="(state.data.visit.amount_paid || 0) + ' ₾'"/></div>
                    <div class="cvp_card" t-if="state.data.visit.state !== 'paid'">
                        <div class="cvp_ctitle">გადახდის მეთოდი</div>
                        <select class="cvp_payin cvp_paysel" t-on-change="onPayMethod">
                            <option t-foreach="payMethods" t-as="m" t-key="m.key"
                                    t-att-value="m.key" t-att-selected="state.payMethod === m.key"
                                    t-esc="m.label"/>
                        </select>
                    </div>
                    <div class="cvp_card" t-if="state.data.visit.state !== 'paid' and showCash">
                        <div class="cvp_ctitle">ხელზე (₾)</div>
                        <input type="number" min="0" class="cvp_payin" t-model="state.payCash"/>
                    </div>
                    <div class="cvp_card" t-if="state.data.visit.state !== 'paid' and showTerminal">
                        <div class="cvp_ctitle">ბარათით (₾)</div>
                        <input type="number" min="0" class="cvp_payin" t-model="state.payTerminal"/>
                        <select class="cvp_payin cvp_cardtype mt-1" t-model="state.payCardType">
                            <option value="0">ბარათის ტიპი…</option>
                            <option t-foreach="state.data.card_types" t-as="ct" t-key="ct.id"
                                    t-att-value="ct.id" t-esc="ct.name"/>
                        </select>
                    </div>
                    <div t-if="state.data.visit.state !== 'paid'"
                         t-att-class="'cvp_card ' + (debtPreview > 0 ? 'cvp_debt' : '')">
                        <div class="cvp_ctitle">დავალიანება</div>
                        <div class="cvp_amount" t-esc="debtPreview + ' ₾'"/>
                    </div>
                </div>
                <div class="d-flex gap-2 mt-3 flex-wrap">
                    <button class="btn cvp_paybtn"
                            t-if="state.data.visit.state !== 'paid'"
                            t-att-disabled="state.saving or !totalAmount"
                            t-on-click="registerPayment">💳 გადახდა</button>
                    <button class="btn cvp_finishbtn"
                            t-if="!['done', 'paid'].includes(state.data.visit.state)"
                            t-on-click="finishVisit">✔ ვიზიტის დასრულება</button>
                    <span class="badge text-bg-success align-self-center"
                          t-if="state.data.visit.state === 'paid'">გადახდილია</span>
                </div>
            </div>
        </div>
    </div>
</t>

</templates>
