<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo 19 security: ir.module.category -> res.groups.privilege -> res.groups;
         users link groups via group_ids (not groups_id). -->
    <record id="module_category_clinic" model="ir.module.category">
        <field name="name">Clinic</field>
        <field name="sequence">20</field>
    </record>

    <record id="privilege_clinic" model="res.groups.privilege">
        <field name="name">Clinic Role</field>
        <field name="category_id" ref="module_category_clinic"/>
        <field name="sequence">20</field>
    </record>

    <!-- Clinic Doctor: edits medical / dental / procedures / clinical steps.
         Needs Contact Creation to write patient (res.partner) medical data. -->
    <record id="group_clinic_doctor" model="res.groups">
        <field name="name">Clinic Doctor</field>
        <field name="privilege_id" ref="privilege_clinic"/>
        <field name="implied_ids" eval="[
            (4, ref('base.group_user')),
            (4, ref('base.group_partner_manager')),
        ]"/>
    </record>

    <!-- Clinic Administrator: reception / financial / all appointments;
         also gets standard Purchase + Inventory access for supplies. -->
    <record id="group_clinic_admin" model="res.groups">
        <field name="name">Clinic Administrator</field>
        <field name="privilege_id" ref="privilege_clinic"/>
        <field name="implied_ids" eval="[
            (4, ref('base.group_user')),
            (4, ref('base.group_partner_manager')),
            (4, ref('purchase.group_purchase_user')),
            (4, ref('stock.group_stock_user')),
            (4, ref('stock.group_production_lot')),
            (4, ref('stock.group_stock_multi_locations')),
        ]"/>
    </record>

    <!-- Clinic Supplier: an external vendor who publishes products into the
         clinic Supply Shop and confirms the RFQs sent to them. Gets standard
         Purchase User access; record rules limit them to their OWN orders. -->
    <record id="group_clinic_supplier" model="res.groups">
        <field name="name">Clinic Supplier</field>
        <field name="privilege_id" ref="privilege_clinic"/>
        <field name="implied_ids" eval="[
            (4, ref('base.group_user')),
            (4, ref('purchase.group_purchase_user')),
            (4, ref('stock.group_stock_user')),
            (4, ref('sales_team.group_sale_salesman')),
        ]"/>
    </record>

    <!-- A supplier sees only the sales orders that belong to their company
         (the mirror of clinic orders they must fulfil). -->
    <record id="rule_clinic_supplier_own_sale" model="ir.rule">
        <field name="name">Clinic Supplier: own sales orders only</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="groups" eval="[(4, ref('group_clinic_supplier'))]"/>
        <field name="domain_force">
            [('clinic_supplier_id.commercial_partner_id', '=', user.partner_id.commercial_partner_id.id)]
        </field>
    </record>

    <!-- A supplier's Inventory shows only the products they themselves supply
         (products with a product.supplierinfo line for their company). This
         makes standard Inventory the base, scoped per supplier. -->
    <record id="rule_clinic_supplier_own_template" model="ir.rule">
        <field name="name">Clinic Supplier: own product templates</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="groups" eval="[(4, ref('group_clinic_supplier'))]"/>
        <field name="domain_force">
            [('seller_ids.partner_id.commercial_partner_id', '=', user.partner_id.commercial_partner_id.id)]
        </field>
    </record>
    <record id="rule_clinic_supplier_own_product" model="ir.rule">
        <field name="name">Clinic Supplier: own product variants</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="groups" eval="[(4, ref('group_clinic_supplier'))]"/>
        <field name="domain_force">
            [('seller_ids.partner_id.commercial_partner_id', '=', user.partner_id.commercial_partner_id.id)]
        </field>
    </record>

    <!-- A supplier sees only the purchase orders addressed to their own
         company (their RFQs to confirm), not other vendors' orders. -->
    <record id="rule_clinic_supplier_own_po" model="ir.rule">
        <field name="name">Clinic Supplier: own purchase orders only</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="groups" eval="[(4, ref('group_clinic_supplier'))]"/>
        <field name="domain_force">
            [('partner_id.commercial_partner_id', '=', user.partner_id.commercial_partner_id.id)]
        </field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- ...and only their own vendor pricelist lines. -->
    <record id="rule_clinic_supplier_own_supplierinfo" model="ir.rule">
        <field name="name">Clinic Supplier: own supplierinfo only</field>
        <field name="model_id" ref="product.model_product_supplierinfo"/>
        <field name="groups" eval="[(4, ref('group_clinic_supplier'))]"/>
        <field name="domain_force">
            [('partner_id.commercial_partner_id', '=', user.partner_id.commercial_partner_id.id)]
        </field>
    </record>

    <!-- Batch #2: a doctor may DRAFT a retail sale request for a patient but
         may only edit their own drafts; reading stays open (patient sale
         history on the card). The admin approves/rejects. -->
    <record id="rule_clinic_doctor_sale_write" model="ir.rule">
        <field name="name">Clinic Doctor: edit own draft sale requests only</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="groups" eval="[(4, ref('group_clinic_doctor'))]"/>
        <field name="domain_force">[('user_id', '=', user.id), ('state', '=', 'draft')]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_clinic_doctor_sale_line_write" model="ir.rule">
        <field name="name">Clinic Doctor: edit own draft sale request lines</field>
        <field name="model_id" ref="sale.model_sale_order_line"/>
        <field name="groups" eval="[(4, ref('group_clinic_doctor'))]"/>
        <field name="domain_force">[('order_id.user_id', '=', user.id), ('order_id.state', '=', 'draft')]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- ══ Appointment visibility ══════════════════════════════════════
         GLOBAL rule (no groups) so it AND-restricts every user: a CLINIC visit
         is only readable by its own dentist or by a Clinic Administrator.
         Non-clinic calendar events (ordinary meetings) are untouched. A global
         rule is required here — a group rule would merely OR-widen the base
         `calendar` rules and let doctors see everyone. Users without the clinic
         doctor/admin groups (e.g. reception) are unaffected by the clinic side
         because they don't open the board; they still see non-clinic events. -->
    <record id="rule_clinic_event_visibility" model="ir.rule">
        <field name="name">Clinic: appointment visibility (own dentist or admin)</field>
        <field name="model_id" ref="calendar.model_calendar_event"/>
        <field name="domain_force">['|', '|', ('is_clinic', '=', False), ('id', '!=', False) if user.has_group('clinic_patient_card.group_clinic_admin') else ('id', '=', False), ('dentist_id', '=', user.id)]</field>
    </record>

    <!-- The main administrator is granted both clinic roles by the module's
         post_init_hook (base.user_admin is noupdate, so an XML write is skipped). -->
</odoo>
